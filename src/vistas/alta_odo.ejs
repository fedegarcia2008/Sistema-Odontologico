<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Alta Odontólogo - Secure Dental</title>
</head>

<body>
<%- include('header') %>

<h1>ALTA ODONTOLÓGO</h1>

    <main class="formulario">
        <form action="/odontologo/nuevoalta" method="POST">
            <label>Clave de identificación:</label>
            <input type="text" name="clave">
        </div>

        <div class="campo">
            <label>Nombre:</label>
            <input type="text" name="nombre">
        </div>

        <div class="campo">
            <label>Apellido:</label>
            <input type="text" name="apellido">
        </div>
        

        <div class="campo">
            <label>Tipo de Especialidad:</label>
            <select id="especialidad">
                <option value="">Seleccione una especialidad</option>
                <option value="">Individual</option>
                <option value="">Grupal</option>
            </select>
        </div>
                <!-- o un buscador   
                    <li><a href="#">Ortodoncia</a></li>
                    <li><a href="#">Implantes</a></li>
                    <li><a href="#">Protesis</a></li>
                    <li><a href="#">Limpieza Dental</a></li>
                    <li><a href="#">Restauraciones</a></li>
                    <li><a href="#">Radiografias Dentales</a></li>
                    <li><a href="#">Blanqueamieno Dental</a></li>
                    <li><a href="#">Tratamiento de Conducto</a></li>
                -->
<div class="campo">
            <label>Nro. de consultorio:</label>
            <input type="number" name="IdCons">
        </div>
         
        <input type="submit" value="INGRESAR">
        
    </form>
    </main>
<%- include('footer') %>

</body>
</html>