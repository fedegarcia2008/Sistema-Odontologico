<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Mostrar Horarios - Secure Dental</title>
</head>

<body>

    <%- include('header') %>

        <div>
        <h1>mostrar datos de todos los Horarios</h1>
    </div>
    
<div class="tabla-contenedor">
    <table class="tabla-datos">
        <thead>
            <tr>
            <th >Id Horario</th>
            <th >Dia</th>
            <th >Hora inicio</th>
            <th >Hora Final</th>
            <th >Id Odontologo</th>
            
            </tr>
        </thead>
        <tbody>

            <% if (registros.length > 0) {
                registros.forEach(hor => { %>
                    <tr>
                        <td><%= hor.idhorario %></td>
                        <td><%= hor.dia %></td>
                        <td><%= hor.horario_comienzo.slice(0, 5) %></td>
                        <td><%= hor.horario_final.slice(0, 5) %></td>
                        <td><%= hor.odontologo_idodontologo %></td> 
                    </tr>   
                <% }); %>
            <% }
            else{ %>
                <p>No hay datos para mostrar </p>
            <% } %>

            
        </tbody>
        </table>

    </div>

    <%- include('footer') %>

</body>
</html>