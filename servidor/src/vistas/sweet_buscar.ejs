<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<% if (alert) { %>
    <% if (guardado) { %>
        <script>
            Swal.fire({
                icon: 'success',
                title: '<%= msj %>',
                showConfirmButton: '<%= botonConfirma %>',
                timer: '<%= tiempo %>'
            });
        </script>
    <% } else { %>
        <script>
            Swal.fire({
                icon: 'error',
                title: 'No se encontraron resultados',
                text: '<%= msj %>'
            });
        </script>
    <% } %>
<% } %>