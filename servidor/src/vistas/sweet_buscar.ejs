<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<% if (alert == true) { %>
    <% if (guardado === true) { %>
        <script>
            Swal.fire({
                icon: 'success',
                title: '<%= msj %>',
                showConfirmButton: '<%= botonConfirma %>',
                timer: '<%= tiempo %>'
            });
        </script>
    <% } else if (guardado === false) { %>
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Error al intentar buscar',
                text: '<%= msj %>'
            });
        </script>
    <% } %>
<% } %>