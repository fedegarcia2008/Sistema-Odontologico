<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/estilos.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Modificar Horario - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>


   <h1>MODIFICAR HORARIO</h1>

        <main class="formulario">

    <form onsubmit="busc_id(event)" method="GET">
        <div class="campo">
            <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave" maxlength="3" autocomplete="off">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
</form>

<form onsubmit="busc_dia(event)" method="GET">
        <div class="campo">
             <label>Día </label>
            <select id="dia" name="dia">
                <option value="#">Seleccione un día</option>
                <option value="Lunes">Lunes</option>
                <option value="Martes">Martes</option>
                <option value="Miércoles">Miércoles</option>
                <option value="Jueves">Jueves</option>
                <option value="Viernes">Viernes</option>
                <option value="Sábado">Sábado</option>
            </select>
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
</form>

    </main>




<% if (cargado) { %>
<% if (busc_registros.length > 0 &&  busc_registros.length == 1) { %>

<form onsubmit="mod_id(event)" onsubmit="mod_dia(event)"  method="POST">

<div class="campo">

            <label>Identificador Único</label>
            <input type="text" name="clave" readonly
                            value="<%= busc_registros[0].idhorario %>">
        </div>

        <div class="campo">
            <label>Día </label>
            <select name="dia"
                            value="<%= busc_registros[0].dia %>">
                <option value="#">Seleccione un día</option>
                <option value="Lunes">Lunes</option>
                <option value="Martes">Martes</option>
                <option value="Miércoles">Miércoles</option>
                <option value="Jueves">Jueves</option>
                <option value="Viernes">Viernes</option>
                <option value="Sábado">Sábado</option>
            </select>
        </div>
        
        <div class="campo">
            <label>Hora inicio</label>
            <input type="time" name="horaIn"
                            value="<%= busc_registros[0].horario_comienzo %>">
        </div>

        <div class="campo">
            <label>Hora final </label>
            <input type="time" name="horaFi"
                            value="<%= busc_registros[0].horario_final %>">
        </div>

        <div class="campo">
            <label>ID Odontólogo</label>
            <input type="text" name="idOdo" readonly
                            value="<%= busc_registros[0].odontologo_idodontologo %>">
        </div>

        <div class="boton">
            <input type="submit" value="GUARDAR CAMBIOS">
        </div>

    </form>
<br>
<% } else if (busc_registros.length >= 2) { %>
    
        <div class="tabla-contenedor">
            <table class="tabla-datos">
                  <thead>
                    <tr>
                    <th >Id Horario</th>
                    <th >Dia</th>
                    <th >Hora inicio</th>
                    <th >Hora Final</th>
                    <th >Id Odontologo</th>
            </tr>
        </thead>
        <tbody>
                    <% busc_registros.forEach(hor => { %>
                    <tr>
                        <td><%= hor.idhorario %></td>
                        <td><%= hor.dia %></td>
                        <td><%= hor.horario_comienzo.slice(0, 5) %></td>
                        <td><%= hor.horario_final.slice(0, 5) %></td>
                        <td><%= hor.odontologo_idodontologo %></td> 
                    </tr>   
                <% }); %>
                    <p>Mas de una coincidencia al buscar. Modifique por ID</p>
                </tbody>
            </table>
        </div>

   <% } else if (busc_registros.length == 0) { %>

        <div class="formulario vacio">
            <i class="fa-solid fa-user-slash"></i>
            <p>No hay datos para mostrar.</p>
        </div>

    <% } %>
<% } %>


<!-- revisar el sweet alert -->
<%- include('../componentes/sweet_alert') %>
<%- include('../componentes/footer') %>
<script src="/js/val_modificar/hor.js"></script>
 
</body>
</html>