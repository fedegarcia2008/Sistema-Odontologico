<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/estilos.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Modificar Cuenta Corriente - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>


   <h1>MODIFICAR CUENTA CORRIENTE</h1>

    <main class="busq-contenedor">
    <div class="busq-grid">

        <form class="busq-item" onsubmit="busc_id(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-id-card"></i> Buscar por C.I.</h2>
        <div class="campo">
            <label>C.I del afiliado<span class="asterisco">*</span></label>
            <input type="text" name="clave" id="clave" minlength="8" placeholder="Ej: 12345678" maxlength="8"
                   pattern="[0-9]{8}" autocomplete="off" required>
                   <span class="ayuda">8 dígitos, sin puntos ni espacios</span>
        </div>
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>

</form>

<form class="busq-item" onsubmit="busc_nom(event)" method="GET">
    <div>
        <h2><i class="fa-solid fa-id-card"></i> Buscar por Nombre del afiliado</h2>
        <div class="campo">
            <label>Apellido y Nombre del afiliado:</label>
            <input type="text" id="nombre" name="nombre" maxlength="20" placeholder="Ej: Lopez Ana" autocomplete="off" required>
        </div>
        </div>

       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
    </form>

    </div>
</main>

<% if (cargado) { %>
<% if (busc_registros.length > 0 &&  busc_registros.length == 1) { %>

<form class="formulario resultado" onsubmit="mod_id(event)" onsubmit="mod_nom(event)" method="POST">

<div class="campo">
            <label>C.I. Afiliado</label>
            <input type="text" name="clave" readonly
                            value="<%= busc_registros[0].afiliado_ci_afiliado %>">
        </div>

        <div class="campo">
            <label>Saldo</label>
            <input type="text" name="saldo" maxlength="10" autocomplete="off" 
                            value="<%= busc_registros[0].saldo %>">
        </div>
        
        <div class="campo">
            <label>ID Historia Clínica</label>
            <input type="text" name="idTrat" readonly
                            value="<%= busc_registros[0].tratamiento_realizado_idtratamiento_realizado %>">
        </div>

        <div class="boton">
            <input type="submit" value="GUARDAR CAMBIOS">
        </div>

    </form>

 <% } else if (busc_registros.length >= 2) { %>

        <div class="tabla-contenedor">
            <table class="tabla-datos">
                <thead>
                    <tr>
                        <th>C.I. Afiliado</th>
                        <th>Saldo</th>
                        <th>ID Historia Clínica</th>
                    </tr>
                </thead>

                <tbody>
                    <% busc_registros.forEach(cta => { %>
                        <tr>
                            <td><%= cta.afiliado_ci_afiliado %></td>
                            <td><%= cta.saldo %></td>
                            <td><%= cta.tratamiento_realizado_idtratamiento_realizado %></td>
                        </tr>
                        
                    <% }); %>
                    <p>Mas de una coincidencia al buscar. Modifique por ID</p>
                </tbody>
            </table>
        </div>

    <% } else if (busc_registros.length == 0) { %>

        <div class="formulario vacio">
            <i class="fa-solid fa-user-slash"></i>
            <p>No hay datos para mostrar.</p>
        </div>

    <% } %>
<% } %>


 <!-- revisar el sweet alert -->

<%- include('../componentes/footer') %>
<script src="/js/val_modificar/cta.js"></script>
 
</body>
</html>