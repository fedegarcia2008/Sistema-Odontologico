<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/estilos.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Modificar Afiliado - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>


   <h1>MODIFICAR AFILIADO</h1>

        <main class="formulario">

    <form onsubmit="busc_id(event)" method="GET">
        <div class="campo">
            <label>Clave de Identificación <span class="asterisco">*</span></label>
            <input type="text" name="clave" id="clave"  minlength="8" maxlength="8"
                   pattern="[0-9]{8}" autocomplete="off" required>
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
</form>

<form onsubmit="busc_nom(event)" method="GET">
        <div class="campo">
            <label>Apellido y Nombre:</label>
            <input type="text" id="nombre" name="nombre" maxlength="20" autocomplete="off" required>
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
    </form>
</main>
    
<% if (cargado) { %>
<% if (busc_registros.length > 0 &&  busc_registros.length == 1) { %>
<main class="formulario">
<form class="formulario resultado" onsubmit="mod_id(event)" onsubmit="mod_nom(event)"  method="POST">

          <div class="campo">
            <label>Clave de Identificacion:</label>
        <input type="name" id="clave" name="clave" readonly value="<%= busc_registros[0].ci_afiliado %>">
</div>

    <div class="fila">
        <div class="campo">
            <label>Nombre:</label>
            <input type="text" name="nombre" maxlength="20" autocomplete="off"
                   value="<%= busc_registros[0].nombre %>">
            </div>
        </div>


        <div class="fila">
        <div class="campo">

            <label>Apellido:</label>
            <input type="text" name="apellido" maxlength="20" autocomplete="off"
                   value="<%= busc_registros[0].apellido %>" >
        </div>

        <div class="fila">
        <div class="campo">
            <label>Celular:</label>
            <input type="text" name="telCelular"
                   value="<%= busc_registros[0].tel_cel %>" maxlength="12" autocomplete="off">
        </div>
    </div>

        <div class="campo">
            <label>Teléfono fijo:</label>
            <input type="text" name="telFijo"
                   value="<%= busc_registros[0].tel_fijo %>" maxlength="9" autocomplete="off">
        </div>

        <div class="fila">
        <div class="campo">
           <label>Tipo de plan <span class="asterisco">*</span></label>
            <select name="tipo" required>
                <option value="">Seleccione un plan</option>
                <option value="Individual">Individual</option>
                <option value="Grupal">Grupal</option>
            </select>
            <input type="text" name="tipo"  value="<%= busc_registros[0].tipo_plan %>" >

        </div>
</div>

        <div class="boton">
            <input type="submit" value="GUARDAR CAMBIOS">
        </div>
    </form>

<% } else if (busc_registros.length >= 2) { %>

        <div class="tabla-contenedor">
            <table class="tabla-datos">
                <thead>
                    <tr>
                        <th>C.I.</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Teléfono Celular</th>
                        <th>Teléfono Fijo</th>
                        <th>Tipo de Plan</th>
                    </tr>
                </thead>

                <tbody>
                    <% busc_registros.forEach(afi => { %>
                        <tr>
                            <td><%= afi.ci_afiliado %></td>
                            <td><%= afi.nombre %></td>
                            <td><%= afi.apellido %></td>
                            <td><%= afi.tel_cel ? afi.tel_cel : "Sin teléfono" %></td>
                            <td><%= afi.tel_fijo ? afi.tel_fijo : "Sin teléfono" %></td>
                            <td><%= afi.tipo_plan %></td>
                        </tr>

                        
                    <% }); %>
                    <p>Mas de una coincidencia al buscar. Modifique por ID</p>
                </tbody>
            </table>
        </div>

    <% } else if (busc_registros.length == 0) { %>

        <div class="formulario vacio">
            <i class="fa-solid fa-user-slash"></i>
            <p>No hay datos para mostrar.</p>
        </div>

    <% } %>
<% } %>

</main>

<%- include('../componentes/footer') %>
<script src="/js/val_modificar/afi.js"></script>
 
</body>
</html>