<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/estilos.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Modificar Convenio - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>


   <h1>MODIFICAR CONVENIO</h1>

        <main class="formulario">

    <form onsubmit="busc_id(event)" method="GET">
        <div class="campo">
            <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave" maxlength="2" autocomplete="off" required>
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>

</form>


<form onsubmit="busc_nom(event)" method="GET">
        <div class="campo">
            <label>Nombre:</label>
            <input type="text" id="nombre" name="nombre" maxlength="20" autocomplete="off" required>
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>

</form>

 </main>
   
<% if (cargado) { %>
<% if (busc_registros.length > 0 &&  busc_registros.length == 1) { %>

<form class="formulario resultado" onsubmit="mod_id(event)" onsubmit="mod_nom(event)" method="POST">

<div class="campo">

            <label>Identificador Único</label>
            <input type="text" name="clave" readonly
                            value="<%= busc_registros[0].idconvenio %>">
        </div>

        <div class="campo">
            <label>Nombre</label>
            <input type="text" name="nombre" maxlength="20" autocomplete="off" 
            value="<%= busc_registros[0].nombre %>">
        </div>
        
        <div class="campo">
            <label>Rebaja</label>
            <input type="text" name="rebaja" maxlength="6" autocomplete="off" 
            value="<%= busc_registros[0].rebaja %>">
            
        </div>

        <div class="boton">
            <input type="submit" value="GUARDAR CAMBIOS">
        </div>

    </form>

 <% } else if (busc_registros.length == 0) { %>

        <div class="formulario vacio">
            <i class="fa-solid fa-user-slash"></i>
            <p>No hay datos para mostrar.</p>
        </div>

    <% } %>
<% } %>



<!-- revisar el sweet alert -->

<%- include('../componentes/footer') %>
<script src="/js/val_modificar/conv.js"></script>
 
</body>
</html>