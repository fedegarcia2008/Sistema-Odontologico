<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/estilos.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Modificar Servicio - Secure Dental</title>
</head>

<body>
   <%- include('../componentes/header') %>


   <h1>MODIFICAR SERVICIO</h1>

        <main class="formulario">

    <form onsubmit="busc_id(event)" method="GET">
        <div class="campo">
            <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>

</form>

<form onsubmit="busc_ser(event)" method="GET">
        <div class="campo">
            <label>Servicio:</label>
            <input type="text" id="nom" name="nom" >
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
    </form>


<% if (cargado) { %>
<% if (busc_registros.length > 0 &&  busc_registros.length == 1) { %>

<form class="formulario resultado" onsubmit="mod_id(event)" onsubmit="mod_ser(event)" method="POST">

<div class="campo">

            <label>Id</label>
            <input type="text" name="clave" readonly
                            value="<%= busc_registros[0].idtratamiento %>">
        </div>
        
<div class="campo">
    <label>Tipo de Servicio</label>

    <input type="text" name="nombre" autocomplete="off"  value="<%= busc_registros[0].nombre %>">

    <div id="listaServicios" class="lista-servicios"></div>
</div>

<script>
    let servicio = document.querySelector('[name="nombre"]');
let lista = document.querySelector("#listaServicios");

let servicios = [
    "Odontología",
    "Ortodoncia",
    "Endodoncia",
    "Periodoncia",
    "Implantología",
    "Odontopediatría",
    "Cirugía bucal"
];

servicio.addEventListener("input", function () {
    let texto = this.value.toLowerCase();

    lista.innerHTML = "";

    if (texto === "") {
        lista.style.display = "none";
        return;
    }

    let resultados = servicios.filter(function (nombre) {
        return nombre.toLowerCase().includes(texto);
    });

    resultados.forEach(function (nombre) {
        let opcion = document.createElement("div");

        opcion.textContent = nombre;
        opcion.classList.add("opcion-servicio");

        opcion.addEventListener("click", function () {
            servicio.value = nombre;
            lista.style.display = "none";
        });

        lista.appendChild(opcion);
    });

    lista.style.display = resultados.length > 0 ? "block" : "none";
});

document.addEventListener("click", function (e) {
    if (!servicio.contains(e.target) && !lista.contains(e.target)) {
        lista.style.display = "none";
    }
});
</script>
        <div class="campo">
            <label>Costo</label>
            <input type="text" name="costo" 
                            value="<%= busc_registros[0].costo %>">
        </div>

        <div class="campo">
            <label>id Odontólogo</label>
            <input type="text" name="idOdo" readonly
                            value="<%= busc_registros[0].odontologo_idodontologo %>">
        </div>

        <div class="boton">
            <input type="submit" value="GUARDAR CAMBIOS">
        </div>

    </form>

<% } else if (busc_registros.length >= 2) { %>

        <div class="tabla-contenedor">
            <table class="tabla-datos">
                <thead>
                    <tr>
                        <th>C.I.</th>
                        <th>Nombre</th>
                        <th>Costo</th>
                        <th>ID del odontologo</th>
                    </tr>
                </thead>

                <tbody>
                    <% busc_registros.forEach(ser => { %>
                        <tr>
                            <td><%= ser.idtratamiento %></td>
                            <td><%= ser.nombre %></td>
                            <td><%= ser.costo %></td>
                            <td><%= ser.odontologo_idodontologo %></td>
                        </tr>

                    <% }); %>
                    <p>Mas de una coincidencia al buscar. Modifique por ID</p>
                </tbody>
            </table>
        </div>


 <% } else if (busc_registros.length == 0) { %>

        <div class="formulario vacio">
            <i class="fa-solid fa-user-slash"></i>
            <p>No hay datos para mostrar.</p>
        </div>

    <% } %>
<% } %>

 </main>

        <script>
        function busc_id(event) {
        event.preventDefault();
        let idejs = document.getElementById('clave').value;
        window.location.href = `/servicio/modificarid/${idejs}`;
        document.getElementById('clave').value = "";   
        }

    function mod_id(event) {
        event.preventDefault();

        let formulario = event.target;
        let idejs = formulario.querySelector('[name="clave"]').value;

        formulario.action = `/servicio/modificar/${idejs}`;
        formulario.submit();
    }

    function busc_ser(event) {
        event.preventDefault();
        let idejs = document.getElementById('nom').value;
        window.location.href = `/servicio/modificarservicio/${idejs}`;
        document.getElementById('nom').value = "";        
    }

    function mod_ser(event) {
        event.preventDefault();

        let formulario = event.target;
        let idejs = formulario.querySelector('[name="nom"]').value;

        formulario.action = `/servicio/modificar/${idejs}`;
        formulario.submit();
    }


        </script>





<!-- revisar el sweet alert -->
<%- include('../componentes/sweet_alert') %>
<%- include('../componentes/footer') %>
<script src="/js/val_modificar/ser.js"></script>
 
</body>
</html>