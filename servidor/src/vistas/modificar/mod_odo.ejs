<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/estilos.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Modificar Odontólogo - Secure Dental</title>
</head>

<body>
   <%- include('../componentes/header') %>


   <h1>MODIFICAR ODONTOlOGO</h1>

        <main class="formulario">

    <form onsubmit="busc_id(event)" method="GET">
        <div class="campo">
           <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave" maxlength="3" autocomplete="off" required>
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
</form>

<form onsubmit="busc_nom(event)" method="GET">
        <div class="campo">
            <label>Apellido y Nombre:</label>
                <input type="text" id="nombre" name="nombre" maxlength="20" autocomplete="off" required>
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
    </form>

    


<% if (cargado) { %>
<% if (busc_registros.length > 0 &&  busc_registros.length == 1) { %>

<form class="formulario resultado" onsubmit="mod_id(event)" onsubmit="mod_nom(event)" method="POST">

<div class="campo">
            <label>Clave de identificación</label>
            <input type="text" name="clave" readonly
                            value="<%= busc_registros[0].idodontologo %>">
        </div>

        <div class="campo">
            <label>Nombre</label>
            <input type="text" name="nombre"
                            value="<%= busc_registros[0].nombre %>">
        </div>

        <div class="campo">
            <label>Apellido</label>
            <input type="text" name="apellido" 
                            value="<%= busc_registros[0].apellido %>">
        </div>

<div class="campo">
    <label>Tipo de Especialidad</label>

    <input type="text" name="especialidad" autocomplete="off" value="<%= busc_registros[0].especialidad %>">

    <div id="listaEspecialidades" class="lista-especialidades"></div>
</div>

<div class="campo">
    <label>ID del odontologo</label>

    <input type="text" name="idodo" readonly value="<%= busc_registros[0].odontologo_idodontologo %>">

</div>

<script>
    let servicio = document.querySelector('[name="nombre"]');
let lista = document.querySelector("#listaServicios");

let servicios = [
    "Odontología",
    "Ortodoncia",
    "Endodoncia",
    "Periodoncia",
    "Implantología",
    "Odontopediatría",
    "Cirugía bucal"
];

servicio.addEventListener("input", function () {
    let texto = this.value.toLowerCase();

    lista.innerHTML = "";

    if (texto === "") {
        lista.style.display = "none";
        return;
    }

    let resultados = servicios.filter(function (nombre) {
        return nombre.toLowerCase().includes(texto);
    });

    resultados.forEach(function (nombre) {
        let opcion = document.createElement("div");

        opcion.textContent = nombre;
        opcion.classList.add("opcion-servicio");

        opcion.addEventListener("click", function () {
            servicio.value = nombre;
            lista.style.display = "none";
        });

        lista.appendChild(opcion);
    });

    lista.style.display = resultados.length > 0 ? "block" : "none";
});

document.addEventListener("click", function (e) {
    if (!servicio.contains(e.target) && !lista.contains(e.target)) {
        lista.style.display = "none";
    }
});
</script>

<div class="campo">
            <label>Clave de identificación</label>
            <input type="text" name="idCons" readonly
                            value="<%= busc_registros[0].consultorio_idconsultorio %>">
        </div>
        <div class="boton">
            <input type="submit" value="GUARDAR CAMBIOS">
        </div>

<% } else if (busc_registros.length >= 2) { %>

        <div class="tabla-contenedor">
            <table class="tabla-datos">
                <thead>
                    <tr>
                        <th>C.I.</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Tipo de Especialidad</th>
                        <th>ID del consultorio</th>
                    </tr>
                </thead>

                <tbody>
                    <% busc_registros.forEach(odo => { %>
                        <tr>
                            <td><%= odo.idodontologo %></td>
                            <td><%= odo.nombre %></td>
                            <td><%= odo.apellido %></td>
                            <td><%= odo.especialidad %></td>
                            <td><%= odo.odontologo_idodontologo %></td>
                        </tr>

                        
                    <% }); %>
                    <p>Mas de una coincidencia al buscar. Modifique por ID</p>
                </tbody>
            </table>
        </div>

    </form>

<% } else if (busc_registros.length >= 0) { %>

    <p>No hay datos para mostrar.</p>

<% } %>
 <% } %>
</main>

<!-- se borro sweet alert -->
<!-- revisar el sweet alert -->

<%- include('../componentes/footer') %>
<script src="/js/val_modificar/odo.js"></script>
 
</body>
</html>