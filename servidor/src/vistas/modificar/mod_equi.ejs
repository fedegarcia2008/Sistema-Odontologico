<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/estilos.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Modificar Equipamiento - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>


   <h1>MODIFICAR EQUIPAMIENTO</h1>

        <main class="formulario">

    <form onsubmit="busc_id(event)" method="GET">
        <div class="campo">
            <label>Nro. de serie</label>
            <input type="text" name="clave" maxlength="12" autocomplete="off" required>
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
</form>

    <form onsubmit="busc_tipo(event)" method="GET">
        <div class="campo">
            <label>Tipo de Equipamiento:</label>
            <input type="text" id="tipo" name="tipo" autocomplete="off" required>
             <div id="listaEquipamiento" class="lista"></div>
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>

</form>
    </main>

<% if (cargado) { %>
<% if (busc_registros.length > 0 &&  busc_registros.length == 1) { %>

<form onsubmit="mod_id(event)" onsubmit="mod_tipo(event)"  method="POST">

<div class="campo">
            <label>Nro. de serie </label>
            <input type="text" name="clave" readonly
                            value="<%= busc_registros[0].nroserie %>">
        </div>

        <div class="campo">
            <label>Tipo </label>
            <input type="text" name="tipo"  maxlength="50" autocomplete="off" 
                            value="<%= busc_registros[0].tipo %>">
             <div id="listaEquipamiento" class="lista"></div>
        </div>
        
        <div class="campo">
            <label>Fecha mantenimiento</label>
            <input type="date" name="fecha" 
                            value="<%= busc_registros[0].fecha_mantenimiento %>">
        </div>

        <div class="campo">
            <label>ID consultorio</label>
            <input type="text" name="idCons" readonly
                            value="<%= busc_registros[0].consultorio_idconsultorio %>">
        </div>

        <div class="boton">
            <input type="submit" value="GUARDAR CAMBIOS">
        </div>

    </form>
<br>
<% } else if (busc_registros.length >= 2) { %>

        
<div class="tabla-contenedor">
    <table class="tabla-datos">
        <thead>
            <tr>
            <th >Id</th>
            <th >Tipo</th>
            <th >Fecha</th>
            <th >id Consultorio</th>
            </tr>
        </thead>
        <tbody>
                <% busc_registros.forEach(equi => { %>
                    <tr>
                        <td><%= equi.nroserie %></td>
                        <td><%= equi.tipo %></td>
                        <td><%= new Date(equi.fecha_mantenimiento).toLocaleDateString("es-AR", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "UTC" }) %></td>
                        <td><%= equi.consultorio_idconsultorio %></td>                                        
                    </tr>                    
                <% }); %>
                 <p>Mas de una coincidencia al buscar. Modifique por ID</p>
                </tbody>
            </table>
        </div>

    <% } else if (busc_registros.length == 0) { %>

        <div class="formulario vacio">
            <i class="fa-solid fa-user-slash"></i>
            <p>No hay datos para mostrar.</p>
        </div>

<% } %>
 <% } %>


<!-- revisar el sweet alert -->
<%- include('../componentes/sweet_alert') %>
<%- include('../componentes/footer') %>
<script src="/js/val_modificar/equi.js"></script>
 
</body>
</html>