<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/estilos.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Modificar Turno - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>


   <h1>MODIFICAR TURNO</h1>

        <main class="formulario">

    <form onsubmit="busc_id(event)" method="GET">
        <div class="campo">
            <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
</form>


        <form onsubmit="busc_fechas(event)" method="GET">
            <div class="campo">
                <label>Desde:</label>
                <input type="date" id="fecha1" name="fecha1">
                <label>Hasta:</label>
                <input type="date" id="fecha2" name="fecha2">
            </div>

            <div class="boton">
                <input type="submit" value="BUSCAR POR PERIODO">
            </div>
        </form>



    </main>




<% if (cargado) { %>
<% if (busc_registros.length > 0 &&  busc_registros.length == 1) { %>

<form onsubmit="mod_id(event)"  onsubmit="mod_fechas(event)"  method="POST">

<div class="campo">

            <label>Identificador Único</label>
            <input type="text" name="clave" readonly
                            value="<%= busc_registros[0].idconsulta %>">
        </div>

        <div class="campo">
            <label>Fecha</label>
            <input type="date" name="fecha" 
                            value="<%= busc_registros[0].fecha %>">
        </div>
        
        <div class="campo">
            <label>Hora</label>
            <input type="time" name="hora" 
                            value="<%= busc_registros[0].horario %>">
        </div>
        
        <div class="campo">
            <label>id Odontólogo</label>
            <input type="text" name="idOdo" readonly
                            value="<%= busc_registros[0].odontologo_idodontologo %>">
        </div>

         <div class="campo">
            <label>id afiliado</label>
            <input type="text" name="idAfi" readonly
                            value="<%= busc_registros[0].afiliado_ci_afiliado %>">
        </div>

        <div class="boton">
            <input type="submit" value="GUARDAR CAMBIOS">
        </div>

    </form>

    
<% } else if (busc_registros.length >= 2) { %>
    <div class="tabla-contenedor">
    <table class="tabla-datos">
        <thead>
            <tr>
                <th>ID</th>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Id Odontologo</th>
                <th>Id Afiliado</th>

            </tr>
        </thead>
        <tbody>
                <% busc_registros.forEach(tur => { %>
                    <tr>
                        <td><%= tur.idconsulta %></td>
                        <td><%= new Date(tur.fecha).toLocaleDateString("es-AR", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "UTC" }) %></td>
                        <td><%= tur.horario.slice(0,5) %></td>
                        <td><%= tur.odontologo_idodontologo %></td>
                        <td><%= tur.afiliado_ci_afiliado %></td>
                    </tr>
                <% }); %>
          <p>Mas de una coincidencia al buscar. Modifique por ID</p>

        </tbody>
    </table>
</div>
 <% } else if (busc_registros.length == 0) { %>

        <div class="formulario vacio">
            <i class="fa-solid fa-user-slash"></i>
            <p>No hay datos para mostrar.</p>
        </div>

    <% } %>
<% } %>


<!-- revisar el sweet alert -->
<%- include('../componentes/footer') %>
<script src="/js/val_modificar/tur.js"></script>
 
</body>
</html>