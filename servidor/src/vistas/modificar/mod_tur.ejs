<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Modificar Turno - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>

<h1>MODIFICAR TURNO</h1>

<main class="busq-contenedor">
    <div class="busq-grid">

        <form class="busq-item" onsubmit="busc_id(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-id-card"></i> Buscar por C.I.</h2>
                <div class="campo">
                    <label>Clave de identificación</label>
                    <input type="text" id="clave" name="clave" maxlength="3" placeholder="Ej: 123" autocomplete="off" required>
                    <span class="ayuda">3 dígitos, sin puntos ni espacios</span>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR C.I.">
            </div>
        </form>

        <form class="busq-item" onsubmit="busc_fechas(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-calendar-week"></i> Buscar por período</h2>
                <div class="campo">
                    <label>Desde</label>
                    <input type="date" id="fecha1" name="fecha1" required>
                </div>
                <div class="campo" style="margin-top: 12px;">
                    <label>Hasta</label>
                    <input type="date" id="fecha2" name="fecha2" required>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR PERÍODO">
            </div>
        </form>

    </div>
</main>

<% if (cargado) { %>
<% if (busc_registros.length > 0 &&  busc_registros.length == 1) { %>

    <section class="res-contenedor">
        <form class="res-card" onsubmit="mod_id(event)" onsubmit="mod_fechas(event)" method="POST">

            <div class="res-cabecera">
                <i class="fa-solid fa-calendar-check"></i>
                <div>
                    <h2>Turno</h2>
                    <span class="res-id">ID <%= busc_registros[0].idconsulta %></span>
                </div>
            </div>

            <div class="res-campos">
                <div class="campo">
                    <label>Identificador único</label>
                    <input type="text" name="clave" readonly
                           value="<%= busc_registros[0].idconsulta %>">
                </div>

                <div class="campo">
                    <label>Fecha</label>
                    <input type="date" name="fecha"
                           value="<%= busc_registros[0].fecha %>">
                </div>

                <div class="campo">
                    <label>Hora</label>
                    <input type="time" name="hora"
                           value="<%= busc_registros[0].horario %>">
                </div>

                <div class="campo">
                    <label>ID odontólogo</label>
                    <input type="text" name="idOdo" readonly
                           value="<%= busc_registros[0].odontologo_idodontologo %>">
                </div>

                <div class="campo" style="grid-column: 1 / -1;">
                    <label>ID afiliado</label>
                    <input type="text" name="idAfi" readonly
                           value="<%= busc_registros[0].afiliado_ci_afiliado %>">
                </div>
            </div>

            <div class="boton">
                <input type="submit" value="GUARDAR CAMBIOS">
            </div>
        </form>
    </section>

<% } else if (busc_registros.length >= 2) { %>

    <p class="res-aviso">Hay más de una coincidencia. Buscá por C.I. para modificar.</p>

    <div class="tabla-contenedor">
        <table class="tabla-datos">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Hora</th>
                    <th>Id Odontólogo</th>
                    <th>Id Afiliado</th>
                </tr>
            </thead>
            <tbody>
                <% busc_registros.forEach(tur => { %>
                    <tr>
                        <td><%= tur.idconsulta %></td>
                        <td><%= new Date(tur.fecha).toLocaleDateString("es-AR", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "UTC" }) %></td>
                        <td><%= tur.horario.slice(0,5) %></td>
                        <td><%= tur.odontologo_idodontologo %></td>
                        <td><%= tur.afiliado_ci_afiliado %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>

<% } else if (busc_registros.length == 0) { %>

    <section class="res-contenedor">
        <div class="res-card res-vacio">
            <i class="fa-solid fa-user-slash"></i>
            <p>No hay datos para mostrar.</p>
        </div>
    </section>

<% } %>
<% } %>

<%- include('../componentes/sweet_modificar') %>
<%- include('../componentes/footer') %>
<script src="/js/val_modificar/tur.js"></script>

</body>
</html>