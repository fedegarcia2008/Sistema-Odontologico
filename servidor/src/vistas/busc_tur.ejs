<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Buscar Turnos - Secure Dental</title>
</head>

<body>
 <%- include('header') %>


    <h1>BUSCAR TURNO</h1>

        <main class="formulario">

    <form onsubmit="busc_id(event)" method="GET">
        <div class="campo">
            <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave"  >
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
    
</form>

    
        <form onsubmit="busc_fecha(event)" method="GET">
            <div class="campo">
                <label>Fecha:</label>
                <input type="date" id="fecha" name="fecha">
            </div>

            <div class="boton">
                <input type="submit" value="BUSCAR POR FECHA">
            </div>
        </form>

        <form onsubmit="busc_odo(event)" method="GET">
            <div class="campo">
                <label>ID odontólogo:</label>
                <input type="text" id="idOdo" name="idOdo">
            </div>

            <div class="boton">
                <input type="submit" value="BUSCAR POR ID ODONTÓLOGO">
            </div>
        </form>


    </main>

<% if (cargado) { %>
        <% if (busc_registros.length > 0) { %>
      
                <p>Clave:  <%= busc_registros[0].idconsulta %></p>
                <p>Fecha:  <%= new Date(busc_registros[0].fecha).toLocaleDateString("es-AR", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "UTC" }) %></p>
                <p>Horario:  <%= busc_registros[0].horario.slice(0,5) %></p>
                <p>Id Odonotologo:  <%= busc_registros[0].odontologo_idodontologo %></p>
                <p>Id Afiliado:  <%= busc_registros[0].afiliado_ci_afiliado %></p>
                
      
      
            <% } else { %>

                    <p> No hay datos para mostrar</p>

            <% } %>
 <% } %>

 
<% if (cargado) { %>
<div class="tabla-contenedor">
    <table class="tabla-datos">
        <thead>
            <tr>
                <th>ID</th>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Id Odontologo</th>
                <th>Id Afiliado</th>

            </tr>
        </thead>
        <tbody>
            <% if (busc_registros.length > 0) {
                busc_registros.forEach(tur => { %>
                    <tr>
                        <td><%= tur.idconsulta %></td>
                        <td><%= new Date(tur.fecha).toLocaleDateString("es-AR", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "UTC" }) %></td>
                        <td><%= tur.horario.slice(0,5) %></td>
                        <td><%= tur.odontologo_idodontologo %></td>
                        <td><%= tur.afiliado_ci_afiliado %></td>
                    </tr>
                <% });
            } else { %>
                <tr>
                    <td colspan="6" class="sin-datos">No hay datos para mostrar</td>
                </tr>
            <% } %>
<% } %>
        </tbody>
    </table>
</div>

<%- include('footer') %>
<script src="/js/val_busctur.js"></script>
</body>
</html>