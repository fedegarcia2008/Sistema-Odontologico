<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css"> <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Consulta 3 - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>
<div class="tema-verde">

    <h1>TRATAMIENTOS MÁS SOLICITADOS</h1>

        <main class="formulario">

        <form onsubmit="busc_fechas(event)" method="GET">
            <h2><i class="fa-solid fa-calendar-days"></i> Buscar por períodos</h2>
            <div class="campo">
                <label>Desde:</label>
                <input type="date" id="fecha1" name="fecha1" required>
                <label>Hasta:</label>
                <input type="date" id="fecha2" name="fecha2" required>
            </div>

            <div class="boton">
                <input type="submit" value="BUSCAR POR PERIODO">
            </div>
        </form>

</main>

<% if (cargado) { %>
<div class="tabla-contenedor">
    <table class="tabla-datos">
        <thead>
            <tr>
                <th>id TRATAMIENTO</th>
                <th>Nombre</th>
                <th>Cantidad</th>
            </tr>
        </thead>
        <tbody>
            <% if (busc_registros.length > 0) {
                busc_registros.forEach(trat => { %>
                    <tr>
                        <td><%= trat.idtratamiento %></td>
                        <td><%= trat.nombre %></td>
                        <td><%= trat.cantidad %></td>
                    </tr>
                <% });
            } else { %>
                <tr>
                    <td colspan="6" class="sin-datos">No hay datos para mostrar</td>
                </tr>
            <% } %>
                      <% } %>
        </tbody>
    </table>
</div>



</div>
<%- include('../componentes/footer') %>


<script src="/js/val_consultas/cons3.js"></script>
</body>
</html>