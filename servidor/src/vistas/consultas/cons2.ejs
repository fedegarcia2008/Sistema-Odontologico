<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css"> <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Consulta 2 - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>
<div class="tema-verde">

    <h1>listado de odontologos por especialidad</h1>


<div class="tabla-contenedor">
    <table class="tabla-datos">
        <thead>
            <tr>
                <th>Especialidad</th>
                <th>Cantidad</th>
                <th>Odontologo/s</th>
            </tr>
        </thead>
        <tbody>
            <% if (registros.length > 0) {
                registros.forEach(odo => { %>
                    <tr>
                        <td><%= odo.especialidad %></td>
                        <td><%= odo.cantidad_odontologos %></td>
                        <td><%= odo.odontologos %></td>
                    </tr>
                <% });
            } else { %>
                <tr>
                    <td colspan="6" class="sin-datos">No hay datos para mostrar</td>
                </tr>
            <% } %>
                 
        </tbody>
    </table>
</div>



</div>
<%- include('../componentes/footer') %>





</body>
</html>