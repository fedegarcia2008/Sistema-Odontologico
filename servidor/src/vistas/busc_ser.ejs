<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Buscar Servicio - Secure Dental</title>
</head>

<body>
 <%- include('header') %>


    <h1>BUSCAR SERVICIO</h1>

        <main class="formulario">

    <form onsubmit="busc_id(event)" method="GET">
        <div class="campo">
            <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave"  >
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
        
    </form>


    <form onsubmit="busc_nom(event)" method="GET">
        <div class="campo">
            <label>Nombre del Servicio</label>
            <input type="text" id="nom" name="nom">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR POR SERVICIO">
        </div>
        
    </form>


    </main>

<% if (cargado) { %>
        <% if (busc_registros.length > 0) { %>
      
                <p>Clave:  <%= busc_registros[0].idtratamiento %></p>
                <p>Nombre:  <%= busc_registros[0].nombre %></p>
                <p>costo:  <%= busc_registros[0].costo %></p>
                <p>id del odontologo:  <%= busc_registros[0].odontologo_idodontologo %></p>
      
            <% } else { %>

                    <p> No hay datos para mostrar</p>

            <% } %>
 <% } %>

 <% if (cargado) { %>
<div class="tabla-contenedor">
    <table class="tabla-datos">
        <thead>
            <tr>
                <th>C.I.</th>
                <th>Nombre</th>
                <th>costo</th>
                <th>Id odontologo</th>
            </tr>
        </thead>
        <tbody>
            <% if (busc_registros.length > 0) {
                busc_registros.forEach(ser => { %>
                    <tr>
                        <td><%= ser.idtratamiento %></td>
                        <td><%= ser.nombre %></td>
                        <td><%= ser.costo %></td>
                        <td><%= ser.odntologo_idodontologo %></td>
                    </tr>
                <% });
            } else { %>
                <tr>
                    <td colspan="6" class="sin-datos">No hay datos para mostrar</td>
                </tr>
            <% } %>
                      <% } %>
        </tbody>
    </table>
</div>

<%- include('footer') %>
<script src="/js/val_buser.js"></script>
</body>
</html>