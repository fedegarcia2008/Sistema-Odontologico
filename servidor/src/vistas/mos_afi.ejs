<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Mostrar Afiliado - Secure Dental</title>
</head>

<body>

    <%- include('header') %>
    
<div>
    <h1>Mostrar datos de todos los afiliados</h1>
</div>

<div class="tabla-contenedor">
    <table class="tabla-datos">
        <thead>
            <tr>
                <th>C.I.</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Teléfono Celular</th>
                <th>Teléfono Fijo</th>
                <th>Tipo de Plan</th>
            </tr>
        </thead>
        <tbody>
            <% if (registros.length > 0) {
                registros.forEach(afi => { %>
                    <tr>
                        <td><%= afi.ci_afiliado %></td>
                        <td><%= afi.nombre %></td>
                        <td><%= afi.apellido %></td>
                        <td><%= afi.tel_cel ? afi.tel_cel : "Sin teléfono" %></td>
                        <td><%= afi.tel_fijo ? afi.tel_fijo : "Sin teléfono" %></td>
                        <td><%= afi.tipo_plan %></td>
                    </tr>
                <% });
            } else { %>
                <tr>
                    <td colspan="6" class="sin-datos">No hay datos para mostrar</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

    <%- include('footer') %>

</body>
</html>