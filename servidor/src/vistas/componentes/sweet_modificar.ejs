<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<% if (alert) { %>
    <% if (guardado) { %>
        <script>
            Swal.fire({
                icon: 'success',
                title: '<%= msj %>',
                timer: '<%= tiempo %>',
              
            });
        </script>
    <% } else { %>
        <script>
            Swal.fire({
                icon: 'error',
                title: '<%= msj %>',
                timer: '<%= tiempo %>',
            });
        </script>
    <% } %>
<% } %>