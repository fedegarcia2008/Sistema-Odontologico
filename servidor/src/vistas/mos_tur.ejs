<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Mostrar Turnos - Secure Dental</title>
</head>

<body>

    <%- include('header') %>

        <div class="container">
        <h1>mostrar datos de todos los Turnos</h1>
    </div>
    
    <div >
        <div class="tabla-contenedor">
        <table class="tabla-datos">
        <thead>
            <tr>
            <th >Id </th>
            <th >Fecha</th>
            <th >Hora</th>
            <th >Id Odontologo</th>
            <th >Id Afilido</th>
            
            </tr>
        </thead>
        <tbody>

            <% if (registros.length > 0) {
                registros.forEach(tur => { %>
                    <tr>
                        <td><%= tur.idconsulta %></td>
                        <td><%= new Date(tur.fecha).toLocaleDateString("es-AR", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "UTC" }) %></td>
                        <td><%= tur.horario %></td>
                        <td><%= tur.odontologo_idodontologo %></td>  
                        <td><%= tur.afiliado_ci_afiliado %></td> 
                    </tr>   
                <% }); %>
            <% }
            else{ %>
                <p>No hay datos para mostrar </p>
            <% } %>

            
        </tbody>
        </table>
        </div>

    </div>

    <%- include('footer') %>

</body>
</html>