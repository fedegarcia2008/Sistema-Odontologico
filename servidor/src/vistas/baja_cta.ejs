<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Baja Cuenta Corriente - Secure Dental</title>
</head>

<body>
 <%- include('header') %>

    <h1>BAJA CUENTA CORRIENTE</h1>
 <main class="formulario">

    <form onsubmit="busc_id(event)" method="GET">
        <div class="campo">
            <label>Ci Afiliado:</label>
            <input type="text" id="clave" name="clave" maxlength="10">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>

</form>

<form onsubmit="busc_nom(event)" method="GET">
        <div class="campo">
            <label>Apellido y nombre del afiliado:</label>
            <input type="text" id="nombre" name="nombre" maxlength="20">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>

</form>

    
<% if (cargado) { %>
<% if (baja_registros.length > 0 &&  baja_registros.length == 1) { %>

<form class="formulario resultado" onsubmit="baja_id(event)" onsubmit="baja_nom(event)" method="POST">

          <div class="campo">
            <label>Ci Afiliado:</label>
        <input type="name" id="clave" name="clave" readonly value="<%= baja_registros[0].afiliado_ci_afiliado %>">
</div>

    <div class="fila">
        <div class="campo">
            <label>Saldo:</label>
            <input type="text" name="saldo"
                   readonly value="<%= baja_registros[0].saldo %>" >
            </div>
        </div>


        <div class="fila">
        <div class="campo">

            <label>Id Historia Clinica:</label>
            <input type="text" name="apellido"
                   readonly value="<%= baja_registros[0].tratamiento_realizado_idtratamiento_realizado %>">
        </div>

        <div class="boton">
            <input type="submit" value="ELIMINAR">
        </div>

    </form>

 <% } else if (baja_registros.length >= 2) { %>

        <div class="tabla-contenedor">
            <table class="tabla-datos">
                <thead>
                    <tr>
                        <th>C.I. Afiliado</th>
                        <th>Saldo</th>
                        <th>ID Historia Clínica</th>
                    </tr>
                </thead>

                <tbody>
                    <% baja_registros.forEach(cta => { %>
                        <tr>
                            <td><%= cta.afiliado_ci_afiliado %></td>
                            <td><%= cta.saldo %></td>
                            <td><%= cta.tratamiento_realizado_idtratamiento_realizado %></td>
                        </tr>
                        
                    <% }); %>
                    <p>Mas de una coincidencia al buscar. Modifique por ID</p>
                </tbody>
            </table>
        </div>

    <% } else if (baja_registros.length == 0) { %>

        <div class="formulario vacio">
            <i class="fa-solid fa-user-slash"></i>
            <p>No hay datos para mostrar.</p>
        </div>

    <% } %>
<% } %>

</main>

        <script>
        function busc_id(event) {
        event.preventDefault();
        let idejs = document.getElementById('clave').value;
        window.location.href = `/cuentacorriente/bajaid/${idejs}`;
        document.getElementById('clave').value = "";   
        }

    function baja_id(event) {
        event.preventDefault();

        let formulario = event.target; // guarda en la variable formulario lo que esta dentro de <form>
        let idejs = formulario.querySelector('[name="clave"]').value;

        formulario.action = `/cuentacorriente/baja/${idejs}`;
        formulario.submit();
    }


    function busc_nom(event) {
        event.preventDefault();
        let idejs = document.getElementById('nombre').value;
        window.location.href = `/cuentacorriente/bajanom/${idejs}`;
        document.getElementById('nombre').value = "";   
        }

    function baja_nom(event) {
        event.preventDefault();

        let formulario = event.target; // guarda en la variable formulario lo que esta dentro de <form>
        let idejs = formulario.querySelector('[name="nombre"]').value;

        formulario.action = `/cuentacorriente/baja/${idejs}`;
        formulario.submit();
    }
        </script>

            <%- include('footer') %>
 
</body>
</html>