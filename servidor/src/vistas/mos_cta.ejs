<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Mostrar Cta Cte - Secure Dental</title>
</head>

<body>

    <%- include('header') %>

        <div>
        <h1>mostrar datos de todas las Cta Cte</h1>
    </div>
<div class="tabla-contenedor">
    <table class="tabla-datos">
        <thead>
            <tr>
            <th >Id Afiliado</th>
            <th >saldo</th>
            <th >id Historia Clinica</th>
            </tr>
        </thead>
        <tbody>

            <% if (registros.length > 0) {
                registros.forEach(cta => { %>
                    <tr>
                        <td><%= cta.afiliado_ci_afiliado %></td>
                        <td><%= cta.saldo %></td>
                        <td><%= cta.tratamiento_realizado_idtratamiento_realizado %></td>                                         
                    </tr>                    
                <% }); %>
            <% }
            else{ %>
                <p>No hay datos para mostrar </p>
            <% } %>

            
        </tbody>
        </table>

    </div>

    <%- include('footer') %>

</body>
</html>