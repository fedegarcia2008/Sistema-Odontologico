<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Buscar Servicio - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>

<h1>BUSCAR SERVICIO</h1>

<main class="busq-contenedor">
    <div class="busq-grid">

        <form class="busq-item" onsubmit="busc_id(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-id-card"></i> Buscar por C.I.</h2>
                <div class="campo">
                    <label>Clave de identificación</label>
                    <input type="text" id="clave" name="clave" autocomplete="off" placeholder="Ej: 01" maxlength="2" required>
                    <span class="ayuda">2 dígitos, sin puntos ni espacios</span>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR CLAVE">
            </div>
        </form>

        <form class="busq-item" onsubmit="busc_nom(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-tooth"></i> Buscar por nombre</h2>
                <div class="campo">
                    <label>Nombre del servicio</label>
                    <input type="text" id="nom" name="nom" autocomplete="off" required>
                    <div id="listaServicios" class="lista"></div>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR SERVICIO">
            </div>
        </form>

        <form class="busq-item" onsubmit="busc_odo(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-user-doctor"></i> Buscar por odontólogo</h2>
                <div class="campo">
                    <label>ID del odontólogo</label>
                    <input type="text" id="odo" name="odo" maxlength="3" placeholder="Ej: 123" autocomplete="off" required>
                    <span class="ayuda">3 dígitos, sin puntos ni espacios</span>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR ODONTÓLOGO">
            </div>
        </form>

    </div>
</main>

<% if (cargadoid) { %>
    <section class="res-contenedor">
        <% if (busc_registros.length > 0) { %>

            <div class="res-card">
                <div class="res-cabecera">
                    <i class="fa-solid fa-tooth"></i>
                    <div>
                        <h2><%= busc_registros[0].nombre %></h2>
                        <span class="res-id">ID <%= busc_registros[0].idtratamiento %></span>
                    </div>
                </div>

                <div class="res-campos">
                    <div class="campo">
                        <label>Clave de identificación</label>
                        <input type="text" readonly value="<%= busc_registros[0].idtratamiento %>">
                    </div>

                    <div class="campo">
                        <label>Costo</label>
                        <input type="text" readonly value="<%= busc_registros[0].costo %>">
                    </div>

                    <div class="campo">
                        <label>Nombre del servicio</label>
                        <input type="text" readonly value="<%= busc_registros[0].nombre %>">
                    </div>

                    <div class="campo">
                        <label>ID odontólogo</label>
                        <input type="text" readonly value="<%= busc_registros[0].odontologo_idodontologo %>">
                    </div>
                </div>
            </div>

        <% } else { %>

            <div class="res-card res-vacio">
                <i class="fa-solid fa-circle-xmark"></i>
                <p>No hay datos para mostrar</p>
            </div>

        <% } %>
    </section>
<% } %>

<% if (cargadotabla) { %>
    <div class="tabla-contenedor">
        <table class="tabla-datos">
            <thead>
                <tr>
                    <th>C.I.</th>
                    <th>Nombre</th>
                    <th>Costo</th>
                    <th>ID odontólogo</th>
                </tr>
            </thead>
            <tbody>
                <% if (busc_registros.length > 0) {
                    busc_registros.forEach(ser => { %>
                        <tr>
                            <td><%= ser.idtratamiento %></td>
                            <td><%= ser.nombre %></td>
                            <td><%= ser.costo %></td>
                            <td><%= ser.odontologo_idodontologo %></td>
                        </tr>
                    <% });
                } else { %>
                    <tr>
                        <td colspan="4" class="sin-datos">No hay datos para mostrar</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
<% } %>

<%- include('../componentes/sweet_buscar') %>
<%- include('../componentes/footer') %>
<script src="/js/val_buscar/ser.js"></script>

</body>
</html>