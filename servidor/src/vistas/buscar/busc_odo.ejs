<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Buscar Odontologos - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>


    <h1>BUSCAR ODONTOLOGO</h1>

        <main class="formulario">

    <form onsubmit="busc_id(event)" method="GET">
        <div class="campo">
            <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave" maxlength="3">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
</form>

    
        <form onsubmit="busc_nom(event)" method="GET">
            <div class="campo">
                <label>Apellido y Nombre:</label>
                <input type="text" id="nombre" name="nombre" maxlength="20">
            </div>

            <div class="boton">
                <input type="submit" value="BUSCAR POR NOMBRE">
            </div>
        </form>

        <form onsubmit="busc_cons(event)" method="GET">
            <div class="campo">
                <label>Id del Consultorio:</label>
                <input type="text" id="cons" name="idCons" maxlength="3">
            </div>

            <div class="boton">
                <input type="submit" value="BUSCAR POR CONSULTORIO">
            </div>
        </form>

        
        <form onsubmit="busc_espe(event)" method="GET">
            <div class="campo">
                <label>Especialidad:</label>
                <input type="text" id="espe" name="espe" maxlength="50">
                <div id="listaEspecialidades" class="lista"></div>
            </div>

            <div class="boton">
                <input type="submit" value="BUSCAR POR ESPECIALIDAD">
            </div>
        </form>

    </main>

<% if (cargadoid) { %>
        <% if (busc_registros.length > 0) { %>
      
                <p>Clave:  <%= busc_registros[0].idodontologo %></p>
                <p>Nombre:  <%= busc_registros[0].nombre%></p>
                <p>Apellido:  <%= busc_registros[0].apellido %></p>
                <p>Especialidad:  <%= busc_registros[0].especialidad %></p>
                <p>Id consultorio:  <%= busc_registros[0].consultorio_idconsultorio %></p>
                
      
      
            <% } else { %>

                    <p> No hay datos para mostrar</p>

            <% } %>
 <% } %>

 
<% if (cargadotabla) { %>
<div class="tabla-contenedor">
    <table class="tabla-datos">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Especialidad</th>
                <th>Id Consultorio</th>
            </tr>
        </thead>
        <tbody>
            <% if (busc_registros.length > 0) {
                busc_registros.forEach(odo => { %>
                    <tr>
                        <td><%= odo.idodontologo %></td>
                        <td><%= odo.nombre %></td>
                        <td><%= odo.apellido %></td>
                        <td><%= odo.especialidad %></td>
                        <td><%= odo.consultorio_idconsultorio %></td>
                    </tr>
                <% });
            } else { %>
                <tr>
                    <td colspan="6" class="sin-datos">No hay datos para mostrar</td>
                </tr>
            <% } %>
                      <% } %>
        </tbody>
    </table>
</div>

<%- include('../componentes/footer') %>
<script src="/js/val_buscar/odo.js"></script>
</body>
</html>