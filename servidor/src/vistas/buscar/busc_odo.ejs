<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Buscar Odontólogo - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>

<h1>BUSCAR ODONTÓLOGO</h1>

<main class="busq-contenedor">
    <div class="busq-grid busq-2x2">

        <form class="busq-item" onsubmit="busc_id(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-id-card"></i> Buscar por C.I.</h2>
                <div class="campo">
                    <label>Clave de identificación</label>
                    <input type="text" id="clave" name="clave" maxlength="3" autocomplete="off" placeholder="Ej: 123" required>
                    <span class="ayuda">3 dígitos, sin puntos ni espacios</span>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR CLAVE">
            </div>
        </form>

        <form class="busq-item" onsubmit="busc_nom(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-user-doctor"></i> Buscar por nombre</h2>
                <div class="campo">
                    <label>Apellido y Nombre</label>
                    <input type="text" id="nombre" name="nombre" maxlength="20" autocomplete="off" placeholder="Ej: Torres Ana" required>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR NOMBRE">
            </div>
        </form>

        <form class="busq-item" onsubmit="busc_cons(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-door-open"></i> Buscar por consultorio</h2>
                <div class="campo">
                    <label>ID del consultorio</label>
                    <input type="text" id="cons" name="idCons" maxlength="3" autocomplete="off" placeholder="Ej: 123" required>
                    <span class="ayuda">3 dígitos, sin puntos ni espacios</span>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR CONSULTORIO">
            </div>
        </form>

        <form class="busq-item" onsubmit="busc_espe(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-tooth"></i> Buscar por especialidad</h2>
                <div class="campo">
                    <label>Especialidad</label>
                    <input type="text" id="espe" name="espe" maxlength="50" autocomplete="off" required>
                    <div id="listaEspecialidades" class="lista"></div>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR ESPECIALIDAD">
            </div>
        </form>

    </div>
</main>

<% if (cargadoid) { %>
    <section class="res-contenedor">
        <% if (busc_registros.length > 0) { %>

            <div class="res-card">
                <div class="res-cabecera">
                    <i class="fa-solid fa-user-doctor"></i>
                    <div>
                        <h2><%= busc_registros[0].nombre %> <%= busc_registros[0].apellido %></h2>
                        <span class="res-id">ID <%= busc_registros[0].idodontologo %></span>
                    </div>
                </div>

                <div class="res-campos">
                    <div class="campo">
                        <label>Clave de identificación</label>
                        <input type="text" readonly value="<%= busc_registros[0].idodontologo %>">
                    </div>

                    <div class="campo">
                        <label>Especialidad</label>
                        <input type="text" readonly value="<%= busc_registros[0].especialidad %>">
                    </div>

                    <div class="campo">
                        <label>Nombre</label>
                        <input type="text" readonly value="<%= busc_registros[0].nombre %>">
                    </div>

                    <div class="campo">
                        <label>Apellido</label>
                        <input type="text" readonly value="<%= busc_registros[0].apellido %>">
                    </div>

                    <div class="campo" style="grid-column: 1 / -1;">
                        <label>ID consultorio</label>
                        <input type="text" readonly value="<%= busc_registros[0].consultorio_idconsultorio %>">
                    </div>
                </div>
            </div>

        <% } else { %>

            <div class="res-card res-vacio">
                <i class="fa-solid fa-circle-xmark"></i>
                <p>No hay datos para mostrar</p>
            </div>

        <% } %>
    </section>
<% } %>

<% if (cargadotabla) { %>
    <div class="tabla-contenedor">
        <table class="tabla-datos">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Especialidad</th>
                    <th>ID consultorio</th>
                </tr>
            </thead>
            <tbody>
                <% if (busc_registros.length > 0) {
                    busc_registros.forEach(odo => { %>
                        <tr>
                            <td><%= odo.idodontologo %></td>
                            <td><%= odo.nombre %></td>
                            <td><%= odo.apellido %></td>
                            <td><%= odo.especialidad %></td>
                            <td><%= odo.consultorio_idconsultorio %></td>
                        </tr>
                    <% });
                } else { %>
                    <tr>
                        <td colspan="5" class="sin-datos">No hay datos para mostrar</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
<% } %>

<%- include('../componentes/sweet_buscar') %>
<%- include('../componentes/footer') %>
<script src="/js/val_buscar/odo.js"></script>

</body>
</html>