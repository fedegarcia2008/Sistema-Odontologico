<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Buscar Historia Clinica - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>


    <h1>BUSCAR HISTORIA CLINICA</h1>

        <main class="formulario">

    <form onsubmit="busc_id(event)" method="GET">
        <div class="campo">
            <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave" maxlength="3" autocomplete="off" required >
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
    
</form>

    
        <form onsubmit="busc_fecha(event)" method="GET">
            <div class="campo">
                <label>Fecha:</label>
                <input type="date" id="fecha" name="fecha" required>
            </div>

            <div class="boton">
                <input type="submit" value="BUSCAR POR FECHA">
            </div>
        </form>

        
        <form onsubmit="busc_afi(event)" method="GET">
            <div class="campo">
                <label>Id afiliado <span class="asterisco">*</span></label>
            <input type="text" name="idAfi" id="idAfi" minlength="8" maxlength="8"
                   pattern="[0-9]{8}" autocomplete="off" required>
            </div>

            <div class="boton">
                <input type="submit" value="BUSCAR POR ID AFILIADO">
            </div>
        </form>

        <form onsubmit="busc_odo(event)" method="GET">
            <div class="campo">
                  <label>Id odontologo <span class="asterisco">*</span></label>
            <input type="text" name="idOdo" id="idOdo" maxlength="3" required>
            </div>

            <div class="boton">
                <input type="submit" value="BUSCAR POR ID ODONTÓLOGO">
            </div>
        </form>

        
    <form onsubmit="busc_trat(event)" method="GET">

  <div class="campo">
            <label>Tipo de Tratamiento </label>
            <select name="trat_rea" id="trat_rea" required>
                <option value="">Seleccione una opción</option>
                <option value= 1>Finalizado</option>
                <option value= 0>En curso</option>
            </select>
            </div>
       <div class="boton">
        <input type="submit" value="BUSCAR POR ESTADO DE TRATAMIENTO">
        </div>
</form>


    </main>

<% if (cargadoid) { %>
        <% if (busc_registros.length > 0) { %>
      
                <p>Clave:  <%= busc_registros[0].idtratamiento_realizado %></p>
                <p>Fecha de inicio:  <%= new Date(busc_registros[0].fecha_inicio).toLocaleDateString("es-AR", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "UTC" }) %></p>
                <p>Tratamiento finalizado:  <%= busc_registros[0].tratamiento_finalizado ? "Finalizado" : "En curso" %></p>
                <p>Tratamiento:  <%= busc_registros[0].tratamiento_idtratamiento %></p>
                <p>Id del afiliado:  <%= busc_registros[0].afiliado_ci_afiliado %></p>
                <p>Id del odontologo: <%= busc_registros[0].odontologo_idodontologo %></p>
                <p>Id turno: <%= busc_registros[0].consulta_idconsulta %></p>
      
            <% } else { %>

                    <p> No hay datos para mostrar</p>

            <% } %>
 <% } %>

<% if (cargadotabla) { %>
<div class="tabla-contenedor">
    <table class="tabla-datos">
        <thead>
            <tr>
            <th >Id Tratamiento</th>
            <th >Fecha</th>
            <th >Tratamiento Realizado</th>
            <th >Tipo de Tratamiento</th>
            <th >id Afiliado</th>
            <th >id Odontologo</th>
            <th >id Turno</th>

            </tr>
        </thead>
        <tbody>
            <% if (busc_registros.length > 0) {
                busc_registros.forEach(his => { %>
                    <tr>
                        <td><%= his.idtratamiento_realizado %></td>
                        <td><%= new Date(his.fecha_inicio).toLocaleDateString("es-AR", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "UTC" }) %></td>
                        <td><%= his.tratamiento_finalizado ? "Finalizado" : "En curso" %></td>
                        <td><%= his.tratamiento_idtratamiento %></td>
                        <td><%= his.afiliado_ci_afiliado %></td>
                        <td><%= his.odontologo_idodontologo %></td>
                        <td><%= his.consulta_idconsulta %></td>
                    </tr>
                <% });
            } else { %>
                <tr>
                    <td colspan="6" class="sin-datos">No hay datos para mostrar</td>
                </tr>
            <% } %>
<% } %>
        </tbody>
    </table>
</div>

<%- include('../componentes/sweet_buscar') %>
<%- include('../componentes/footer') %>
<script src="/js/val_buscar/his.js"></script>
</body>
</html>