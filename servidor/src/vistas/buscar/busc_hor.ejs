<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Buscar Horario - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>

<h1>BUSCAR HORARIO</h1>

<main class="busq-contenedor">
    <div class="busq-grid">

        <form class="busq-item" onsubmit="busc_id(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-id-card"></i> Buscar por C.I.</h2>
                <div class="campo">
                    <label>Clave de identificación</label>
                    <input type="text" id="clave" name="clave" maxlength="3" placeholder="Ej: 123" autocomplete="off" required>
                    <span class="ayuda">3 dígitos, sin puntos ni espacios</span>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR C.I.">
            </div>
        </form>

        <form class="busq-item" onsubmit="busc_dia(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-calendar-day"></i> Buscar por día</h2>
                <div class="campo">
                    <label>Día</label>
                    <select name="dia" id="dia" required>
                        <option value="">Seleccione un día</option>
                        <option value="Lunes">Lunes</option>
                        <option value="Martes">Martes</option>
                        <option value="Miercoles">Miércoles</option>
                        <option value="Jueves">Jueves</option>
                        <option value="Viernes">Viernes</option>
                        <option value="Sabado">Sábado</option>
                    </select>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR DÍA">
            </div>
        </form>

        <form class="busq-item" onsubmit="busc_odo(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-user-doctor"></i> Buscar por odontólogo</h2>
                <div class="campo">
                    <label>ID odontólogo</label>
                    <input type="text" id="idOdo" name="idOdo" maxlength="3" placeholder="Ej: 123" autocomplete="off" required>
                    <span class="ayuda">3 dígitos, sin puntos ni espacios</span>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR ODONTÓLOGO">
            </div>
        </form>

    </div>
</main>

<% if (cargadoid) { %>
    <section class="res-contenedor">
        <% if (busc_registros.length > 0) { %>

            <div class="res-card">
                <div class="res-cabecera">
                    <i class="fa-solid fa-clock"></i>
                    <div>
                        <h2><%= busc_registros[0].dia %></h2>
                        <span class="res-id">ID <%= busc_registros[0].idhorario %></span>
                    </div>
                </div>

                <div class="res-campos">
                    <div class="campo">
                        <label>Identificador único</label>
                        <input type="text" readonly value="<%= busc_registros[0].idhorario %>">
                    </div>

                    <div class="campo">
                        <label>Día</label>
                        <input type="text" readonly value="<%= busc_registros[0].dia %>">
                    </div>

                    <div class="campo">
                        <label>Horario de comienzo</label>
                        <input type="text" readonly value="<%= busc_registros[0].horario_comienzo.slice(0, 5) %>">
                    </div>

                    <div class="campo">
                        <label>Horario final</label>
                        <input type="text" readonly value="<%= busc_registros[0].horario_final.slice(0, 5) %>">
                    </div>

                    <div class="campo" style="grid-column: 1 / -1;">
                        <label>ID odontólogo</label>
                        <input type="text" readonly value="<%= busc_registros[0].odontologo_idodontologo %>">
                    </div>
                </div>
            </div>

        <% } else { %>

            <div class="res-card res-vacio">
                <i class="fa-solid fa-circle-xmark"></i>
                <p>No hay datos para mostrar</p>
            </div>

        <% } %>
    </section>
<% } %>

<% if (cargadotabla) { %>
    <div class="tabla-contenedor">
        <table class="tabla-datos">
            <thead>
                <tr>
                    <th>ID horario</th>
                    <th>Día</th>
                    <th>Hora inicio</th>
                    <th>Hora final</th>
                    <th>ID odontólogo</th>
                </tr>
            </thead>
            <tbody>
                <% if (busc_registros.length > 0) {
                    busc_registros.forEach(hor => { %>
                        <tr>
                            <td><%= hor.idhorario %></td>
                            <td><%= hor.dia %></td>
                            <td><%= hor.horario_comienzo.slice(0, 5) %></td>
                            <td><%= hor.horario_final.slice(0, 5) %></td>
                            <td><%= hor.odontologo_idodontologo %></td>
                        </tr>
                    <% });
                } else { %>
                    <tr>
                        <td colspan="5" class="sin-datos">No hay datos para mostrar</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
<% } %>

<%- include('../componentes/sweet_buscar') %>
<%- include('../componentes/footer') %>
<script src="/js/val_buscar/hor.js"></script>

</body>
</html>