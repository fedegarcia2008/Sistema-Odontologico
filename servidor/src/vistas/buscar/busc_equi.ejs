<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Buscar Equipamiento - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>

<h1>BUSCAR EQUIPAMIENTO</h1>

<main class="busq-contenedor">
    <div class="busq-grid busq-2x2">

        <form class="busq-item" onsubmit="busc_id(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-barcode"></i> Buscar por N° de serie</h2>
                <div class="campo">
                    <label>Nro. de serie</label>
                    <input type="text" name="clave" id="clave" maxlength="12" placeholder="Ej: AB-1234" autocomplete="off" required>
                    <span class="ayuda">2 letras y 4 dígitos</span>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR N° DE SERIE">
            </div>
        </form>

        <form class="busq-item" onsubmit="busc_fecha(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-calendar-days"></i> Buscar por fecha</h2>
                <div class="campo">
                    <label>Fecha de mantenimiento</label>
                    <input type="date" id="fecha" name="fecha" autocomplete="off" required>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR FECHA">
            </div>
        </form>

        <form class="busq-item" onsubmit="busc_cons(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-door-open"></i> Buscar por consultorio</h2>
                <div class="campo">
                    <label>ID Consultorio</label>
                    <input type="text" id="idCons" name="idCons" maxlength="3" placeholder="Ej: 123" autocomplete="off" required>
                    <span class="ayuda">3 dígitos, sin puntos ni espacios</span>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR CONSULTORIO">
            </div>
        </form>

        <form class="busq-item" onsubmit="busc_tipo(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-screwdriver-wrench"></i> Buscar por tipo</h2>
                <div class="campo">
                    <label>Tipo de equipamiento</label>
                    <input type="text" id="tipo" name="tipo" autocomplete="off" required>
                    <div id="listaEquipamiento" class="lista"></div>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR TIPO">
            </div>
        </form>

    </div>
</main>

<% if (cargadoid) { %>
    <section class="res-contenedor">
        <% if (busc_registros.length > 0) { %>

            <div class="res-card">
                <div class="res-cabecera">
                    <i class="fa-solid fa-screwdriver-wrench"></i>
                    <div>
                        <h2><%= busc_registros[0].tipo %></h2>
                        <span class="res-id">N° <%= busc_registros[0].nroserie %></span>
                    </div>
                </div>

                <div class="res-campos">
                    <div class="campo">
                        <label>Número de serie</label>
                        <input type="text" readonly value="<%= busc_registros[0].nroserie %>">
                    </div>

                    <div class="campo">
                        <label>Tipo</label>
                        <input type="text" readonly value="<%= busc_registros[0].tipo %>">
                    </div>

                    <div class="campo">
                        <label>Fecha de mantenimiento</label>
                        <input type="text" readonly value="<%= new Date(busc_registros[0].fecha_mantenimiento).toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }) %>">
                    </div>

                    <div class="campo">
                        <label>ID consultorio</label>
                        <input type="text" readonly value="<%= busc_registros[0].consultorio_idconsultorio %>">
                    </div>
                </div>
            </div>

        <% } else { %>

            <div class="res-card res-vacio">
                <i class="fa-solid fa-circle-xmark"></i>
                <p>No hay datos para mostrar</p>
            </div>

        <% } %>
    </section>
<% } %>

<% if (cargadotabla) { %>
    <div class="tabla-contenedor">
        <table class="tabla-datos">
            <thead>
                <tr>
                    <th>Número de serie</th>
                    <th>Tipo</th>
                    <th>Fecha de mantenimiento</th>
                    <th>ID consultorio</th>
                </tr>
            </thead>
            <tbody>
                <% if (busc_registros.length > 0) {
                    busc_registros.forEach(equi => { %>
                        <tr>
                            <td><%= equi.nroserie %></td>
                            <td><%= equi.tipo %></td>
                            <td><%= new Date(equi.fecha_mantenimiento).toLocaleDateString("es-AR", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "UTC" }) %></td>
                            <td><%= equi.consultorio_idconsultorio %></td>
                        </tr>
                    <% });
                } else { %>
                    <tr>
                        <td colspan="4" class="sin-datos">No hay datos para mostrar</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
<% } %>

<%- include('../componentes/sweet_buscar') %>
<%- include('../componentes/footer') %>
<script src="/js/val_buscar/equi.js"></script>

</body>
</html>