<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Buscar Equipamientos - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>


  <main class="busq-contenedor">
     <div class="busq-grid busq-2x2">

        <form class="busq-item" onsubmit="busc_id(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-id-card"></i> Buscar por numero de serie</h2>
        <div class="campo">
            <label>Nro. de serie</label>
            <input type="text" name="clave" id="clave" maxlength="12" placeholder="Ej: AB-1234" autocomplete="off" required>
            <span class="ayuda">2 letras y 4 dígitos</span>
        </div>
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR POR NUMERO DE SERIE">
        </div>
    
    </form>
    
        <form class="busq-item" onsubmit="busc_fecha(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-id-card"></i> Buscar por fecha</h2>
                <div class="campo">
                <label>Fecha:</label>
                <input type="date" id="fecha" name="fecha" autocomplete="off" required>
            </div>
            </div>

            <div class="boton">
                <input type="submit" value="BUSCAR POR FECHA">
            </div>
        </form>

        <form class="busq-item" onsubmit="busc_cons(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-id-card"></i> Buscar por ID del consultorio</h2>
            <div class="campo">
                <label>ID Consultorio:</label>
                <input type="text" id="idCons" name="idCons" maxlength="3" placeholder="Ej: 123" autocomplete="off" required>
                <span class="ayuda">3 digitos, sin puntos ni espacios</span>
            </div>
            </div>

            <div class="boton">
                <input type="submit" value="BUSCAR POR CONSULTORIO">
            </div>
        </form>


        <form class="busq-item" onsubmit="busc_tipo(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-id-card"></i> Buscar por tipo de Equipamiento</h2>
            <div class="campo">
                <label>Tipo de Equipamiento:</label>
                <input type="text" id="tipo" name="tipo" autocomplete="off" required>
                        <div id="listaEquipamiento" class="lista"></div>
            </div>
            </div>

            <div class="boton">
                <input type="submit" value="BUSCAR POR TIPO DE EQUIPAMIENTO">
            </div>
        </form>

        </div>
    </main>

<% if (cargadoid) { %>
        <% if (busc_registros.length > 0) { %>
      
                <p>Numero de Serie:  <%= busc_registros[0].nroserie %></p>
                <p>Tipo:  <%= busc_registros[0].tipo%></p>
                <p>Fecha de Mantenimiento:  <%= new Date(busc_registros[0].fecha_mantenimiento).toLocaleDateString("es-AR", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "UTC" }) %></p>
                <p>Id consultorio:  <%= busc_registros[0].consultorio_idconsultorio %></p>
      
      
            <% } else { %>

                    <p> No hay datos para mostrar</p>

            <% } %>
 <% } %>

 
<% if (cargadotabla) { %>
<div class="tabla-contenedor">
    <table class="tabla-datos">
        <thead>
            <tr>
                <th>Numero de serie</th>
                <th>Tipo</th>
                <th>Fecha de Mantenimiento</th>
                <th>Id Consultorio</th>
               

            </tr>
        </thead>
        <tbody>
            
            <% if (busc_registros.length > 0) {
                busc_registros.forEach(equi => { %>
                    <tr>
                        <td><%= equi.nroserie %></td> 
                        <td><%= equi.tipo %></td>
                        <td><%= new Date(equi.fecha_mantenimiento).toLocaleDateString("es-AR", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "UTC" }) %></td>
                        <td><%= equi.consultorio_idconsultorio %></td>
                    </tr>
                <% });
            } else { %>
                <tr>
                    <td colspan="6" class="sin-datos">No hay datos para mostrar</td>
                </tr>
            <% } %>
<% } %>
        </tbody>
    </table>
</div>

<%- include('../componentes/sweet_buscar') %>
<%- include('../componentes/footer') %>
<script src="/js/val_buscar/equi.js"></script>

</body>
</html>