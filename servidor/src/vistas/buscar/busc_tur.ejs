<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Buscar Turno - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>

<h1>BUSCAR TURNO</h1>

<main class="busq-contenedor">
    <div class="busq-grid busq-5">

        <form class="busq-item" onsubmit="busc_id(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-id-card"></i> Buscar por C.I.</h2>
                <div class="campo">
                    <label>Clave de identificación</label>
                    <input type="text" id="clave" name="clave" placeholder="Ej: 123" maxlength="3" autocomplete="off" required>
                    <span class="ayuda">3 dígitos, sin puntos ni espacios</span>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR C.I.">
            </div>
        </form>

        <form class="busq-item" onsubmit="busc_fecha(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-calendar-day"></i> Buscar por fecha</h2>
                <div class="campo">
                    <label>Fecha</label>
                    <input type="date" id="fecha" name="fecha" required>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR FECHA">
            </div>
        </form>

        <form class="busq-item" onsubmit="busc_fechas(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-calendar-week"></i> Buscar por período</h2>
                <div class="campo">
                    <label>Desde</label>
                    <input type="date" id="fecha1" name="fecha1" required>
                </div>
                <div class="campo" style="margin-top: 12px;">
                    <label>Hasta</label>
                    <input type="date" id="fecha2" name="fecha2" required>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR PERÍODO">
            </div>
        </form>

        <form class="busq-item" onsubmit="busc_odo(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-user-doctor"></i> Buscar por odontólogo</h2>
                <div class="campo">
                    <label>ID odontólogo</label>
                    <input type="text" id="idOdo" name="idOdo" maxlength="3" placeholder="Ej: 123" autocomplete="off" required>
                    <span class="ayuda">3 dígitos, sin puntos ni espacios</span>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR ODONTÓLOGO">
            </div>
        </form>

        <form class="busq-item" onsubmit="busc_afi(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-user"></i> Buscar por afiliado</h2>
                <div class="campo">
                    <label>ID afiliado</label>
                    <input type="text" name="idAfi" minlength="8" maxlength="8"
                           pattern="[0-9]{8}" autocomplete="off" placeholder="Ej: 12345678" required>
                    <span class="ayuda">8 dígitos, sin puntos ni espacios</span>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR AFILIADO">
            </div>
        </form>

    </div>
</main>

<% if (cargadoid) { %>
    <section class="res-contenedor">
        <% if (busc_registros.length > 0) { %>

            <div class="res-card">
                <div class="res-cabecera">
                    <i class="fa-solid fa-calendar-check"></i>
                    <div>
                        <h2>Turno</h2>
                        <span class="res-id">ID <%= busc_registros[0].idconsulta %></span>
                    </div>
                </div>

                <div class="res-campos">
                    <div class="campo">
                        <label>Identificador único</label>
                        <input type="text" readonly value="<%= busc_registros[0].idconsulta %>">
                    </div>

                    <div class="campo">
                        <label>Fecha</label>
                        <input type="text" readonly value="<%= new Date(busc_registros[0].fecha).toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }) %>">
                    </div>

                    <div class="campo">
                        <label>Horario</label>
                        <input type="text" readonly value="<%= busc_registros[0].horario.slice(0,5) %>">
                    </div>

                    <div class="campo">
                        <label>ID odontólogo</label>
                        <input type="text" readonly value="<%= busc_registros[0].odontologo_idodontologo %>">
                    </div>

                    <div class="campo" style="grid-column: 1 / -1;">
                        <label>ID afiliado</label>
                        <input type="text" readonly value="<%= busc_registros[0].afiliado_ci_afiliado %>">
                    </div>
                </div>
            </div>

        <% } else { %>

            <div class="res-card res-vacio">
                <i class="fa-solid fa-circle-xmark"></i>
                <p>No hay datos para mostrar</p>
            </div>

        <% } %>
    </section>
<% } %>

<% if (cargadotabla) { %>
    <div class="tabla-contenedor">
        <table class="tabla-datos">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Hora</th>
                    <th>ID odontólogo</th>
                    <th>ID afiliado</th>
                </tr>
            </thead>
            <tbody>
                <% if (busc_registros.length > 0) {
                    busc_registros.forEach(tur => { %>
                        <tr>
                            <td><%= tur.idconsulta %></td>
                            <td><%= new Date(tur.fecha).toLocaleDateString("es-AR", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "UTC" }) %></td>
                            <td><%= tur.horario.slice(0,5) %></td>
                            <td><%= tur.odontologo_idodontologo %></td>
                            <td><%= tur.afiliado_ci_afiliado %></td>
                        </tr>
                    <% });
                } else { %>
                    <tr>
                        <td colspan="5" class="sin-datos">No hay datos para mostrar</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
<% } %>

<%- include('../componentes/sweet_buscar') %>
<%- include('../componentes/footer') %>
<script src="/js/val_buscar/tur.js"></script>

</body>
</html>