<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
     <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Buscar Afiliado - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>


    <h1>BUSCAR AFILIADO</h1>

        <main class="formulario">

    <form onsubmit="busc_id(event)" method="GET">
        <div class="campo">
            <label>Clave de Identificación <span class="asterisco">*</span></label>
            <input type="text" name="clave" id="clave"  minlength="8" maxlength="8"
                   pattern="[0-9]{8}" autocomplete="off" required>
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR POR CI">
        </div>
</form>

        

    <form onsubmit="busc_nom(event)" method="GET">
        <div class="campo">
            <label>Apellido y Nombre:</label>
            <input type="text" id="nombre" name="nombre" maxlength="20" autocomplete="off" required>
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR POR NOMBRE">
        </div>
</form>


    <form onsubmit="busc_plan(event)" method="GET">

  <div class="campo">
            <label>Tipo de plan <span class="asterisco">*</span></label>
            <select name="plan" id="plan" required>
                <option value="" >Seleccione un plan</option>
                <option value="Individual">Individual</option>
                <option value="Grupal">Grupal</option>
            </select>
     </div> 
        
       <div class="boton">
        <input type="submit" value="BUSCAR POR TIPO DE PLAN">
        </div>
</form>

    </main>

<% if (cargadoid) { %>
    <section class="res-contenedor">
        <% if (busc_registros.length > 0) { %>
            <div class="res-card">
                <div class="res-cabecera">
                    <i class="fa-solid fa-user"></i>
                    <div>
                        <h2><%= busc_registros[0].nombre %> <%= busc_registros[0].apellido %></h2>
                        <span class="res-id">C.I. <%= busc_registros[0].ci_afiliado %></span>
                    </div>
                </div>

                <div class="res-datos">
                    <div class="res-dato">
                        <small>Celular</small>
                        <strong><%= busc_registros[0].tel_cel ? busc_registros[0].tel_cel : "Sin teléfono" %></strong>
                    </div>
                    <div class="res-dato">
                        <small>Teléfono fijo</small>
                        <strong><%= busc_registros[0].tel_fijo ? busc_registros[0].tel_fijo : "Sin teléfono" %></strong>
                    </div>
                    <div class="res-dato">
                        <small>Plan</small>
                        <strong><%= busc_registros[0].tipo_plan %></strong>
                    </div>
                </div>
            </div>
        <% } else { %>
            <div class="res-card res-vacio">
                <i class="fa-solid fa-user-slash"></i>
                <p>No hay datos para mostrar</p>
            </div>
        <% } %>
    </section>
<% } %>

<% if (cargadotabla) { %>
    <div class="tabla-contenedor">
        <table class="tabla-datos">
            <thead>
                <tr>
                    <th>C.I.</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Teléfono Celular</th>
                    <th>Teléfono Fijo</th>
                    <th>Tipo de Plan</th>
                </tr>
            </thead>
            <tbody>
                <% if (busc_registros.length > 0) {
                    busc_registros.forEach(afi => { %>
                        <tr>
                            <td><%= afi.ci_afiliado %></td>
                            <td><%= afi.nombre %></td>
                            <td><%= afi.apellido %></td>
                            <td><%= afi.tel_cel ? afi.tel_cel : "Sin teléfono" %></td>
                            <td><%= afi.tel_fijo ? afi.tel_fijo : "Sin teléfono" %></td>
                            <td><%= afi.tipo_plan %></td>
                        </tr>
                    <% });
                } else { %>
                    <tr>
                        <td colspan="6" class="sin-datos">No hay datos para mostrar</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
<% } %>





<%- include('../componentes/sweet_buscar') %>
<%- include('../componentes/footer') %>
<script src="/js/val_buscar/afi.js"></script>

</body>
</html>