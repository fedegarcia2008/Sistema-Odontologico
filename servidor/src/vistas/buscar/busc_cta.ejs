<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Buscar Cuenta Corriente - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>


    <h1>BUSCAR CUENTA CORRIENTE</h1>

 <main class="busq-contenedor">
    <div class="busq-grid">

        <form class="busq-item" onsubmit="busc_id(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-id-card"></i> Buscar por C.I.</h2>
        <div class="campo">
          <label>ID del afiliado</label>
            <input type="text" name="clave"  minlength="8" maxlength="8"
                   pattern="[0-9]{8}" autocomplete="off" placeholder="Ej: 12345678" required>
                   <span class="ayuda">8 dígitos, sin puntos ni espacios</span>
        </div>
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
</form>

<form class="busq-item" onsubmit="busc_idhis(event)" method="GET">
    <div>
        <h2><i class="fa-solid fa-id-card"></i> Buscar por ID de historia clinica</h2>
        <div class="campo">
            <label>Id de la historia clinica:</label>
            <input type="text" id="clavehis" name="clavehis" maxlength="3"  placeholder="Ej: 123" autocomplete="off" required>
            <span class="ayuda">3 dígitos, sin puntos ni espacios</span>
        </div>
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
</form>

<form class="busq-item" onsubmit="busc_nom(event)" method="GET">
    <div>
        <h2><i class="fa-solid fa-id-card"></i> Buscar por el nombre del afiliado</h2>
        <div class="campo">
            <label>Apellido y Nombre del afiliado :</label>
            <input type="text" id="nombre" name="nombre" maxlength="20" autocomplete="off" required>
        </div>
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
</form>

</div>
    </main>

<% if (cargadoid) { %>
        <% if (busc_registros.length > 0) { %>
      
                <p>Id Afiliado:  <%= busc_registros[0].afiliado_ci_afiliado %></p>
                <p>Saldo:  <%= busc_registros[0].saldo%></p>
                <p>ID Tratamiento Realizado:  <%= busc_registros[0].tratamiento_realizado_idtratamiento_realizado %></p>
      
            <% } else { %>

                    <p> No hay datos para mostrar</p>

            <% } %>
 <% } %>


 <% if (cargadotabla) { %>
<div class="tabla-contenedor">
    <table class="tabla-datos">
        <thead>
            <tr>
                <th>C.I.</th>
                <th>Saldo</th>
                <th>Id tratamiento realizado</th>
            </tr>
        </thead>
        <tbody>
            <% if (busc_registros.length > 0) {
                busc_registros.forEach(cta => { %>
                    <tr>
                        <td><%= cta.afiliado_ci_afiliado %></td>
                        <td><%= cta.saldo %></td>
                        <td><%= cta.tratamiento_realizado_idtratamiento_realizado %></td>
                    </tr>
                <% });
            } else { %>
                <tr>
                    <td colspan="6" class="sin-datos">No hay datos para mostrar</td>
                </tr>
            <% } %>
                      <% } %>
        </tbody>
    </table>
</div>
    
<%- include('../componentes/sweet_buscar') %>
<%- include('../componentes/footer') %>
<script src="/js/val_buscar/cta.js"></script>

</body>
</html>