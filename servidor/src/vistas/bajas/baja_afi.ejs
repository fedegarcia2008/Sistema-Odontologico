<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Baja Afiliado - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>

<h1>BAJA AFILIADO</h1>

<main class="busq-contenedor">
    <div class="busq-grid">

        <form class="busq-item" onsubmit="busc_id(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-id-card"></i> Buscar por C.I.</h2>
                <div class="campo">
                    <label>Clave de Identificación <span class="asterisco">*</span></label>
                    <input type="text" id="clave" name="clave" minlength="8" maxlength="8"
                           pattern="[0-9]{8}" autocomplete="off" placeholder="Ej: 12345678" required>
                    <span class="ayuda">8 dígitos, sin puntos ni espacios</span>
                </div>
            </div>

            <div class="boton">
                <input type="submit" value="BUSCAR POR C.I.">
            </div>
        </form>

        <form class="busq-item" onsubmit="busc_nom(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-user"></i> Buscar por nombre</h2>
                <div class="campo">
                    <label>Apellido y Nombre</label>
                    <input type="text" id="nombre" name="nombre" maxlength="20"
                           autocomplete="off" required>
                </div>
            </div>
            
            <div class="boton">
                <input type="submit" value="BUSCAR POR NOMBRE">
            </div>
        </form>

    </div>
</main>


<% if (cargado) { %>

    <% if (baja_registros.length == 1) { %>

        <section class="res-contenedor">
            <form class="res-card" onsubmit="baja_id(event)" method="POST">

                <div class="res-cabecera">
                    <i class="fa-solid fa-user-minus"></i>
                    <div>
                        <h2><%= baja_registros[0].nombre %> <%= baja_registros[0].apellido %></h2>
                        <span class="res-id">C.I. <%= baja_registros[0].ci_afiliado %></span>
                    </div>
                </div>

                <div class="res-campos">
                    <div class="campo">
                        <label>Clave de identificación</label>
                        <input type="text" name="clave" readonly value="<%= baja_registros[0].ci_afiliado %>">
                    </div>

                    <div class="campo">
                        <label>Tipo de plan</label>
                        <input type="text" name="tipo" readonly value="<%= baja_registros[0].tipo_plan %>">
                    </div>

                    <div class="campo">
                        <label>Nombre</label>
                        <input type="text" name="nombre" readonly value="<%= baja_registros[0].nombre %>">
                    </div>

                    <div class="campo">
                        <label>Apellido</label>
                        <input type="text" name="apellido" readonly value="<%= baja_registros[0].apellido %>">
                    </div>

                    <div class="campo">
                        <label>Celular</label>
                        <input type="text" name="telCelular" readonly value="<%= baja_registros[0].tel_cel %>">
                    </div>

                    <div class="campo">
                        <label>Teléfono fijo</label>
                        <input type="text" name="telFijo" readonly value="<%= baja_registros[0].tel_fijo %>">
                    </div>
                </div>

                <div class="boton peligro">
                    <input type="submit" value="ELIMINAR AFILIADO">
                </div>
            </form>
        </section>

    <% } else if (baja_registros.length >= 2) { %>

        <p class="res-aviso">Hay más de una coincidencia. Buscá por C.I. para eliminar.</p>

        <div class="tabla-contenedor">
            <table class="tabla-datos">
                <thead>
                    <tr>
                        <th>C.I.</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Teléfono Celular</th>
                        <th>Teléfono Fijo</th>
                        <th>Tipo de Plan</th>
                    </tr>
                </thead>
                <tbody>
                    <% baja_registros.forEach(afi => { %>
                        <tr>
                            <td><%= afi.ci_afiliado %></td>
                            <td><%= afi.nombre %></td>
                            <td><%= afi.apellido %></td>
                            <td><%= afi.tel_cel ? afi.tel_cel : "Sin teléfono" %></td>
                            <td><%= afi.tel_fijo ? afi.tel_fijo : "Sin teléfono" %></td>
                            <td><%= afi.tipo_plan %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

    <% } else { %>

        <section class="res-contenedor">
            <div class="res-card res-vacio">
                <i class="fa-solid fa-user-slash"></i>
                <p>No hay datos para mostrar.</p>
            </div>
        </section>

    <% } %>

<% } %>

<%- include('../componentes/sweet_baja') %>
<%- include('../componentes/footer') %>
<script src="/js/val_bajas/afi.js"></script>

</body>
</html>