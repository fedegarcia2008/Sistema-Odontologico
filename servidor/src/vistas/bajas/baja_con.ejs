<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Baja Convenio - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>

<h1>BAJA CONVENIO</h1>

<main class="busq-contenedor">
    <div class="busq-grid">

        <form class="busq-item" onsubmit="busc_id(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-id-card"></i> Buscar por C.I.</h2>
                <div class="campo">
                    <label for="clave">Clave de identificación</label>
                    <input type="text" id="clave" name="clave" maxlength="2" placeholder="Ej: 01" autocomplete="off" required>
                    <span class="ayuda">2 dígitos, sin puntos ni espacios</span>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR C.I.">
            </div>
        </form>

        <form class="busq-item" onsubmit="busc_nom(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-handshake"></i> Buscar por nombre</h2>
                <div class="campo">
                    <label for="nombre">Nombre</label>
                    <input type="text" id="nombre" name="nombre" maxlength="20" placeholder="Ej: Convenio A" autocomplete="off" required>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR NOMBRE">
            </div>
        </form>

    </div>
</main>

<% if (cargado) { %>
    <% if (baja_registros.length > 0) { %>

        <section class="res-contenedor">
            <form class="res-card" onsubmit="baja_id(event)" method="POST">

                <div class="res-cabecera">
                    <i class="fa-solid fa-handshake"></i>
                    <div>
                        <h2><%= baja_registros[0].nombre %></h2>
                        <span class="res-id">ID <%= baja_registros[0].idconvenio %></span>
                    </div>
                </div>

                <div class="res-campos">
                    <div class="campo">
                        <label for="clave_baja">Clave de identificación</label>
                        <input type="text" id="clave_baja" name="clave" readonly value="<%= baja_registros[0].idconvenio %>">
                    </div>

                    <div class="campo">
                        <label for="rebaja_baja">Rebaja</label>
                        <input type="text" id="rebaja_baja" name="rebaja" readonly value="<%= baja_registros[0].rebaja %>">
                    </div>

                    <div class="campo" style="grid-column: 1 / -1;">
                        <label for="nombre_baja">Nombre</label>
                        <input type="text" id="nombre_baja" name="nombre" readonly value="<%= baja_registros[0].nombre %>">
                    </div>
                </div>

                <div class="boton peligro">
                    <input type="submit" value="ELIMINAR">
                </div>
            </form>
        </section>

    <% } else { %>

        <section class="res-contenedor">
            <div class="res-card res-vacio">
                <i class="fa-solid fa-user-slash"></i>
                <p>No hay datos para mostrar.</p>
            </div>
        </section>

    <% } %>
<% } %>

<%- include('../componentes/sweet_baja') %>
<%- include('../componentes/footer') %>
<script src="/js/val_bajas/conv.js"></script>

</body>
</html>