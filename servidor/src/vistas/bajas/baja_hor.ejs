<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Baja Horario - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>

<h1>BAJA HORARIO</h1>

<main class="busq-contenedor">
    <div class="busq-grid">

        <form class="busq-item" onsubmit="busc_id(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-id-card"></i> Buscar por C.I.</h2>
                <div class="campo">
                    <label>Clave de identificación</label>
                    <input type="text" id="clave" name="clave" maxlength="3" placeholder="Ej: 123" autocomplete="off" required>
                    <span class="ayuda">3 dígitos, sin puntos ni espacios</span>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR C.I.">
            </div>
        </form>

        <form class="busq-item" onsubmit="busc_dia(event)" method="GET">
            <div>
                <h2><i class="fa-solid fa-calendar-day"></i> Buscar por día</h2>
                <div class="campo">
                    <label>Día</label>
                    <select id="dia" name="dia" autocomplete="off" required>
                        <option value="">Seleccione un día</option>
                        <option value="Lunes">Lunes</option>
                        <option value="Martes">Martes</option>
                        <option value="Miércoles">Miércoles</option>
                        <option value="Jueves">Jueves</option>
                        <option value="Viernes">Viernes</option>
                        <option value="Sábado">Sábado</option>
                    </select>
                </div>
            </div>
            <div class="boton">
                <input type="submit" value="BUSCAR POR DÍA">
            </div>
        </form>

    </div>
</main>

<% if (cargado) { %>
<% if (baja_registros.length > 0 &&  baja_registros.length == 1) { %>

    <section class="res-contenedor">
        <form class="res-card" onsubmit="baja_id(event)" onsubmit="baja_dia(event)" method="POST">

            <div class="res-cabecera">
                <i class="fa-solid fa-clock"></i>
                <div>
                    <h2><%= baja_registros[0].dia %></h2>
                    <span class="res-id">ID <%= baja_registros[0].idhorario %></span>
                </div>
            </div>

            <div class="res-campos">
                <div class="campo">
                    <label>Clave de identificación</label>
                    <input type="text" name="clave" readonly value="<%= baja_registros[0].idhorario %>">
                </div>

                <div class="campo">
                    <label>Día</label>
                    <input type="text" name="dia"
                           readonly value="<%=  baja_registros[0].dia%>">
                </div>

                <div class="campo">
                    <label>Horario de entrada</label>
                    <input type="text" name="horario_comienzo"
                           readonly value="<%= baja_registros[0].horario_comienzo.slice(0, 5)%>">
                </div>

                <div class="campo">
                    <label>Horario de salida</label>
                    <input type="text" name=" horario_final"
                           readonly value="<%= baja_registros[0].horario_final.slice(0, 5)%>">
                </div>

                <div class="campo" style="grid-column: 1 / -1;">
                    <label>ID odontólogo</label>
                    <input type="text" name="odontologo_idodontologo" readonly value="<%= baja_registros[0].odontologo_idodontologo %>">
                </div>
            </div>

            <div class="boton peligro">
                <input type="submit" value="ELIMINAR">
            </div>
        </form>
    </section>

<% } else if (baja_registros.length >= 2) { %>

    <p class="res-aviso">Hay más de una coincidencia. Buscá por C.I. para eliminar.</p>

    <div class="tabla-contenedor">
        <table class="tabla-datos">
            <thead>
                <tr>
                    <th>Id Horario</th>
                    <th>Día</th>
                    <th>Hora inicio</th>
                    <th>Hora final</th>
                    <th>Id Odontólogo</th>
                </tr>
            </thead>
            <tbody>
                <% baja_registros.forEach(hor => { %>
                    <tr>
                        <td><%= hor.idhorario %></td>
                        <td><%= hor.dia %></td>
                        <td><%= hor.horario_comienzo.slice(0, 5) %></td>
                        <td><%= hor.horario_final.slice(0, 5) %></td>
                        <td><%= hor.odontologo_idodontologo %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>

<% } else if (baja_registros.length == 0) { %>

    <section class="res-contenedor">
        <div class="res-card res-vacio">
            <i class="fa-solid fa-user-slash"></i>
            <p>No hay datos para mostrar.</p>
        </div>
    </section>

<% } %>
<% } %>

<%- include('../componentes/sweet_baja') %>
<%- include('../componentes/footer') %>
<script src="/js/val_bajas/hor.js"></script>

</body>
</html>