<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Equipamiento - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>

<h1>ALTA EQUIPAMIENTO</h1>

    <main>
    <section class="panel">
        <div class="panel-cabecera">
            <i class="fa-solid fa-user-plus"></i>
            <div>
                <h2>Nuevo afiliado</h2>
                <small>Los campos con * son obligatorios</small>
            </div>
        </div>

            
    <form action="/equipamiento/nuevoalta" method="POST">
        <div class="panel-campos">
        <div class="campo">
            <label>Nro. de serie <span class="asterisco">*</span></label>
            <input type="text" name="clave" maxlength="12" placeholder="Ej: AB-1234" autocomplete="off" required>
            <span class="ayuda">2 letras y 4 dígitos</span>
        </div>

        <div class="campo">
            <label>Tipo <span class="asterisco">*</span></label>
            <input type="text" name="tipo" maxlength="50" autocomplete="off" required>

        <div id="listaEquipamiento" class="lista"></div>
        </div>
        
        <div class="campo">
            <label>Fecha mantenimiento</label>
            <input type="date" name="fecha">
        </div>

        <div class="campo">
            <label>ID consultorio <span class="asterisco">*</span></label>
            <input type="text" name="idCons" maxlength="3" placeholder="Ej: 123" autocomplete="off" required>
            <span class="ayuda">3 digitos, sin puntos ni espacios</span>
        </div>
        </div>

        <div class="boton">
        <input type="submit" value="INGRESAR">
        </div>
        
    </form>
    </section>
    </main>

<%- include('../componentes/sweet_alta') %>

<%- include('../componentes/footer') %>
<script src="/js/val_altas/equi.js"></script>
</body>
</html>