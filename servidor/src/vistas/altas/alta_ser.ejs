<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Alta Servicio - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>

<h1>ALTA SERVICIO</h1>

    <main class="formulario">
        <form action="/servicio/nuevoalta" method="POST">
        <div class="campo">

            <label>Id <span class="asterisco">*</span></label>
            <input type="text" name="clave" maxlength="2" required>
        </div>
        
<div class="campo">
    <label>Tipo de Servicio <span class="asterisco">*</span></label>

    <input type="text" name="nombre" autocomplete="off" required>

    <div id="listaServicios" class="lista"></div>
</div>

        <div class="campo">
            <label>Costo <span class="asterisco">*</span></label>
            <input type="text" name="costo" maxlength="8" required>
        </div>

        <div class="campo">
            <label>id Odontólogo <span class="asterisco">*</span></label>
            <input type="text" name="idOdo" maxlength="3" required>
        </div>
         
        <div class="boton">
        <input type="submit" value="INGRESAR">
        </div>

    </form>
    </main>

<%- include('../componentes/sweet_alta') %>
    
<%- include('../componentes/footer') %>
<script src="/js/val_altas/ser.js"></script>
</body>
</html>