<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Alta Odontólogo - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>

<h1>ALTA ODONTóloGO</h1>

    <main class="formulario">
        <form action="/odontologo/nuevoalta" method="POST">
      <div class="campo">
            <label>Clave de identificación <span class="asterisco">*</span></label>
            <input type="text" name="clave" maxlength="3"  autocomplete="off" required>
        </div>

        <div class="campo">
            <label>Nombre <span class="asterisco">*</span></label>
            <input type="text" name="nombre" maxlength="20"  autocomplete="off" required>
        </div>

        <div class="campo">
            <label>Apellido <span class="asterisco">*</span></label>
            <input type="text" name="apellido" maxlength="20" autocomplete="off" required>
        </div>

<div class="campo">
    <label>Tipo de Especialidad <span class="asterisco">*</span></label>

    <input type="text" name="especialidad" autocomplete="off" required>

    <div id="listaEspecialidades" class="lista"></div>
</div>

<div class="campo">
            <label>ID de consultorio <span class="asterisco">*</span></label>
            <input type="text" name="idCons" maxlength="3" autocomplete="off" required>
        </div>
         
        <div class="boton">
            
        <input type="submit" value="INGRESAR">
        </div>
        
    </form>
    </main>

<%- include('../componentes/sweet_alta') %>

<%- include('../componentes/footer') %>
<script src="/js/val_altas/odo.js"></script>
</body>
</html>