<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Alta Cta. Cte. - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>

<h1>ALTA CUENTA CORRIENTE</h1>

    <main class="formulario">
        <form action="/cuentacorriente/nuevoalta" method="POST"> <!--dps cambiar ruteo en este-->
        <div class="campo">
            <label>C.I. Afiliado <span class="asterisco">*</span></label>
            <input type="text" name="clave" maxlength="10" required>
        </div>

        <div class="campo">
            <label>Saldo <span class="asterisco">*</span></label>
            <input type="text" name="saldo" maxlength="10" required>
        </div>
        
        <div class="campo">
            <label>ID Historia Clínica <span class="asterisco">*</span></label>
            <input type="text" name="idTrat" required>
        </div>

        <div class="boton">
        <input type="submit" value="INGRESAR">
        </div>
        
    </form>
    </main>

<%- include('sweet_alta') %>    

<%- include('../componentes/sweet_alert') %>

<script src="/js/val_altas/cta.js"></script>
</body>
</html>