<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Historia clinica - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>

<h1>ALTA HISTORIA CLINICA</h1>

    <main>
    <section class="panel">
        <div class="panel-cabecera">
            <i class="fa-solid fa-user-plus"></i>
            <div>
                <h2>Nueva Historia Clinica</h2>
                <small>Los campos con * son obligatorios</small>
            </div>
        </div>

            
        <form action="/historiaclinica/nuevoalta" method="POST">
   
        <div class="panel-campos">
        <div class="campo">
            <label>Clave de identificacion <span class="asterisco">*</span></label>
            <input type="text" name="clave" autocomplete="off" placeholder="Ej: 123" required>
            <span class="ayuda">3 dígitos, sin puntos ni espacios</span>
        </div>

        <div class="campo">
            <label>Fecha de inicio <span class="asterisco">*</span></label>
            <input type="date" name="fecha" required>
        </div>

                <div class="campo">
            <label>Tratamiento finalizado <span class="asterisco">*</span></label>
            <select name="idTrat" required>
                <option value="">Seleccione una opción</option>
                <option value= 1>Finalizado</option>
                <option value= 0>En curso</option>
            </select>
        </div>
        <div class="campo">
            <label>Id servicio<span class="asterisco">*</span></label>
            <input type="text" name="idSer" maxlength="2" autocomplete="off" placeholder="Ej: 01" required>
            <span class="ayuda">2 dígitos, sin puntos ni espacios</span>
        </div>

        <div class="campo">
            <label>Id afiliado <span class="asterisco">*</span></label>
            <input type="text" name="idAfi"  minlength="8" maxlength="8"
                   pattern="[0-9]{8}" autocomplete="off" placeholder="Ej: 12345678" required>
                   <span class="ayuda">8 dígitos, sin puntos ni espacios</span>
        </div>

        <div class="campo">
            <label>Id odontologo <span class="asterisco">*</span></label>
            <input type="text" name="idOdo" maxlength="3" autocomplete="off" placeholder="Ej: 123" required>
            <span class="ayuda">3 dígitos, sin puntos ni espacios</span>
        </div>

        <div class="campo">
            <label>Id turno <span class="asterisco">*</span></label>
            <input type="text" name="idTur" maxlength="3" autocomplete="off" placeholder="Ej: 123"  required> <!--maxlenght? pq es AI-->
        <span class="ayuda">3 dígitos, sin puntos ni espacios</span>
        </div>
        </div>

        <div class="boton">
        <input type="submit" value="INGRESAR">
        </div>
        
    </form>

    </section>
    </main>
    
<%- include('../componentes/sweet_alta') %>

<%- include('../componentes/footer') %>
<script src="/js/val_altas/his.js"></script>
</body>
</html>