<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Alta Turno - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>

<h1>ALTA TURNO</h1>

    <main class="formulario">
        <form action="/turno/nuevoalta" method="POST">

        <div class="campo">
            <label>Fecha <span class="asterisco">*</span></label>
            <input type="date" name="fecha" required>
        </div>
        
        <div class="campo">
            <label>Hora <span class="asterisco">*</span></label>
            <input type="time" name="hora" required>
        </div>
        
        <div class="campo">
            <label>id Odontólogo <span class="asterisco">*</span></label>
            <input type="text" name="idOdo" maxlength="3" required>
        </div>

         <div class="campo">
            <label>id afiliado<span class="asterisco">*</span></label>
            <input type="text" name="idAfi"  minlength="8" maxlength="8"
                   pattern="[0-9]{8}" autocomplete="off" required>
        </div>
        
        <div class="boton">
        <input type="submit" value="INGRESAR">
        </div>

    </form>
    </main>

<%- include('../componentes/sweet_alert') %> 

<%- include('../componentes/footer') %>
<script src="/js/val_altas/tur.js"></script>
</body>
</html>