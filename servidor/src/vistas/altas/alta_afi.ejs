<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Alta Afiliado - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>

<h1>ALTA AFILIADO</h1>

<!--
maxlenght limite de caracteres igual a la bdd
size tamaño de la caja de texto-->

   <main>
    <section class="panel">
        <div class="panel-cabecera">
            <i class="fa-solid fa-user-plus"></i>
            <div>
                <h2>Nuevo afiliado</h2>
                <small>Los campos con * son obligatorios</small>
            </div>
        </div>

        <form action="/afiliado/nuevoalta" method="POST">
            <div class="panel-campos">
                <div class="campo">
                    <label>Clave de Identificación <span class="asterisco">*</span></label>
                    <input type="text" name="clave" minlength="8" maxlength="8"
                           pattern="[0-9]{8}" autocomplete="off" placeholder="Ej: 12345678" required>
                    <span class="ayuda">8 dígitos, sin puntos ni espacios</span>
                </div>

                <div class="campo">
                    <label>Tipo de plan <span class="asterisco">*</span></label>
                    <select name="tipo" required>
                        <option value="">Seleccione un plan</option>
                        <option value="Individual">Individual</option>
                        <option value="Grupal">Grupal</option>
                    </select>
                </div>

                <div class="campo">
                    <label>Nombre <span class="asterisco">*</span></label>
                    <input type="text" name="nombre" maxlength="20" autocomplete="off" required>
                </div>

                <div class="campo">
                    <label>Apellido <span class="asterisco">*</span></label>
                    <input type="text" name="apellido" maxlength="20" autocomplete="off" required>
                </div>

                <div class="campo">
                    <label>Teléfono celular <span class="asterisco">*</span></label>
                    <input type="text" name="telCelular"maxlength="12"pattern="11 [0-9]{4}-[0-9]{4}"
                        title="El teléfono debe comenzar con 11 y tener 10 números. Ejemplo: 11 1234-5678"  autocomplete="off"  required>
                </div>

                <div class="campo">
                    <label>Teléfono fijo</label>
                    <input type="text" name="telFijo" maxlength="9"  pattern="[0-9]{8}"
                        title="El teléfono fijo debe tener exactamente 8 números" autocomplete="off">
                </div>
            </div>

            <div class="boton">
                <input type="submit" value="INGRESAR">
            </div>
        </form>
    </section>
</main>


<script src="/js/val_altas/afi.js"></script>

<%- include('../componentes/sweet_alta') %>
  
<%- include('../componentes/footer') %>
</body>
</html>