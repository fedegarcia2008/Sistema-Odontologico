<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Alta Convenio - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>

<h1>ALTA CONVENIO</h1>

<main>
    <section class="panel">
        <div class="panel-cabecera">
            <i class="fa-solid fa-user-plus"></i>
            <div>
                <h2>Nuevo Convenio</h2>
                <small>Los campos con * son obligatorios</small>
            </div>
        </div>

        <form action="/convenio/nuevoalta" method="POST">
        <div class="panel-campos">
        
            <div class="campo">
            <label>Identificador Único <span class="asterisco">*</span></label>
            <input type="text" name="clave" maxlength="2" placeholder="Ej: 12" autocomplete="off" required>
            <span class="ayuda">2 dígitos, sin puntos ni espacios</span>
        
        </div>

        <div class="campo">
            <label>Nombre <span class="asterisco">*</span></label>
            <input type="text" name="nombre" maxlength="20" autocomplete="off" required>
        </div>
        
        <div class="campo">
            <label>Rebaja <span class="asterisco">*</span></label>
            <input type="text" name="rebaja" maxlength="2" autocomplete="off" required>
            <span class="ayuda">2 dígitos, sin puntos ni espacios</span>
        </div>
        </div>


        <div class="boton">
        <input type="submit" value="INGRESAR">
        </div>
       
    </form>
    </section>
    </main>

   <script src="/js/val_altas/conv.js"></script>

<%- include('../componentes/sweet_alta') %>
    
<%- include('../componentes/footer') %>
 
</body>
</html>