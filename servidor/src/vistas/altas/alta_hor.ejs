<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Alta Horario - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>

<h1>ALTA HORARIO</h1>

    <main class="formulario">
        <form action="/horario/nuevoalta" method="POST">

        <div class="campo">
            <label>Día <span class="asterisco">*</span></label>
            <select name="dia" required>
                <option value="#">Seleccione un día</option>
                <option value="Lunes">Lunes</option>
                <option value="Martes">Martes</option>
                <option value="Miércoles">Miércoles</option>
                <option value="Jueves">Jueves</option>
                <option value="Viernes">Viernes</option>
                <option value="Sábado">Sábado</option>
            </select>
        </div>
        
        <div class="campo">
            <label>Hora inicio <span class="asterisco">*</span></label>
            <input type="time" name="horaIn" id="horaIn" required>
        </div>

        <div class="campo">
            <label>Hora final <span class="asterisco">*</span></label>
            <input type="time" name="horaFi" id="horaFi" required>
        </div>

        <div class="campo">
            <label>ID Odontólogo <span class="asterisco">*</span></label>
            <input type="text" name="idOdo" maxlength="3"  autocomplete="off" required>
        </div>
         
        <div class="boton">
        <input type="submit" value="INGRESAR">
        </div>

    </form>
    </main>

<%- include('../componentes/sweet_alta') %>

<%- include('../componentes/footer') %>
<script src="/js/val_altas/hor.js"></script>
</body>
</html>