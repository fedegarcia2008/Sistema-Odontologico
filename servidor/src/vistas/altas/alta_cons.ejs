<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Alta Consultorio - Secure Dental</title>
</head>

<body>
<%- include('../componentes/header') %>

<h1>ALTA CONSULTORIO</h1>

    <main>
    <section class="panel">
        <div class="panel-cabecera">
            <i class="fa-solid fa-user-plus"></i>
            <div>
                <h2>Nuevo Consultorio</h2>
                <small>Los campos con * son obligatorios</small>
            </div>
        </div>

        <form action="/consultorio/nuevoalta" method="POST">

            <div class="panel-campos">
        <div class="campo">
            <label>Identificador Único <span class="asterisco">*</span></label>
            <input type="text" name="clave" maxlength="3" placeholder="Ej: 123" autocomplete="off" required>
            <span class="ayuda">3 dígitos, sin puntos ni espacios</span>
        </div>
        
        <div class="campo">
            <label>Nro. de consultorio <span class="asterisco">*</span></label>
            <input type="text" name="nCons" maxlength="3" placeholder="Ej: 001" autocomplete="off" required>
            <span class="ayuda">3 dígitos, sin puntos ni espacios</span>
        </div>

                <div class="campo">
            <label>ID Local <span class="asterisco">*</span></label>
            <input type="text" value="1" name="idLocal" autocomplete="off" readonly>
        </div>
        </div>
        
        <div class="boton">
        <input type="submit" value="INGRESAR">
        </div>
        
    </form>
    </section>
    </main>
    
<%- include('../componentes/sweet_alta') %>

<%- include('../componentes/footer') %>

<script src="/js/val_altas/cons.js"></script>
</body>
</html>