<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Baja Odontologo - Secure Dental</title>
</head>

<body>
 <%- include('header') %>

    <h1>BAJA ODONTOLGO</h1>
 <main class="formulario">

    <form onsubmit="busc_id(event)" method="GET">
        <div class="campo">
            <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave" maxlength="10">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>

</form>

<form onsubmit="busc_nom(event)" method="GET">
        <div class="campo">
            <label>Apellido y Nombre:</label>
            <input type="text" id="nom" name="nom">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>

</form>

    
<% if (cargado) { %>
<% if (baja_registros.length > 0 &&  baja_registros.length == 1) { %>

<form class="formulario resultado" onsubmit="baja_id(event)" onsubmit="baja_nom(event)" method="POST">

          <div class="campo">
            <label>Clave de Identificacion:</label>
        <input type="text" id="clave" name="clave" readonly value="<%= baja_registros[0].idodontologo %>">
</div>

    <div class="fila">
        <div class="campo">
            <label>Nombre:</label>
            <input type="text" name="nombre"
                   readonly value="<%= baja_registros[0].nombre %>" >
            </div>
        </div>


        <div class="fila">
        <div class="campo">

            <label>Apellido:</label>
            <input type="text" name="apellido"
            
                   readonly value="<%= baja_registros[0].apellido %>">
        </div>

        <div class="fila">
        <div class="campo">
            <label>Especialidad:</label>
            <input type="text" name="especialidad"
                   readonly value="<%= baja_registros[0].especialidad %>">
        </div>
    </div>

        <div class="campo">
            <label>Id Consultorio:</label>
            <input type="text" name="consultorio_idconsultorio"
                   readonly value="<%= baja_registros[0].consultorio_idconsultorio %>">
        </div>
</div>

<div class="boton">
            <input type="submit" value="ELIMINAR">
        </div>

<% } else if (baja_registros.length >= 2) { %>

        <div class="tabla-contenedor">
            <table class="tabla-datos">
                <thead>
                    <tr>
                        <th>C.I.</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Tipo de Especialidad</th>
                        <th>ID del consultorio</th>
                    </tr>
                </thead>

                <tbody>
                    <% baja_registros.forEach(odo => { %>
                        <tr>
                            <td><%= odo.idodontologo %></td>
                            <td><%= odo.nombre %></td>
                            <td><%= odo.apellido %></td>
                            <td><%= odo.especialidad %></td>
                            <td><%= odo.odontologo_idodontologo %></td>
                        </tr>

                        
                    <% }); %>
                    <p>Mas de una coincidencia al buscar. Modifique por ID</p>
                </tbody>
            </table>
        </div>

    </form>


    </form>

 <% } else if (baja_registros.length == 0) { %>
        <div class="formulario vacio">
            <i class="fa-solid fa-user-slash"></i>
            <p>No hay datos para mostrar.</p>
        </div>

    <% } %>
<% } %>

</main>

        <script>
        function busc_id(event) {
        event.preventDefault();
        let idejs = document.getElementById('clave').value;
        window.location.href = `/odontologo/bajaid/${idejs}`;
        document.getElementById('clave').value = "";   
        }

    function baja_id(event) {
        event.preventDefault();

        let formulario = event.target; // guarda en la variable formulario lo que esta dentro de <form>
        let idejs = formulario.querySelector('[name="clave"]').value;

        formulario.action = `/odontologo/baja/${idejs}`;
        formulario.submit();
    }

    function busc_nom(event) {
        event.preventDefault();
        let idejs = document.getElementById('nom').value;
        window.location.href = `/odontologo/bajanom/${idejs}`;
        document.getElementById('nom').value = "";   
        }

    function baja_nom(event) {
        event.preventDefault();

        let formulario = event.target; // guarda en la variable formulario lo que esta dentro de <form>
        let idejs = formulario.querySelector('[name="nom"]').value;

        formulario.action = `/odontologo/baja/${idejs}`;
        formulario.submit();
    }
        </script>

            <%- include('footer') %>
 
</body>
</html>