<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Mostrar Equipamientos - Secure Dental</title>
</head>

<body>

    <%- include('header') %>

        <div>
        <h1>mostrar datos de todos los Equipamientos</h1>
    </div>
    
<div class="tabla-contenedor">
    <table class="tabla-datos">
        <thead>
            <tr>
            <th >Id</th>
            <th >Tipo</th>
            <th >Fecha</th>
            <th >id Consultorio</th>
            </tr>
        </thead>
        <tbody>

            <% if (registros.length > 0) {
                registros.forEach(equi => { %>
                    <tr>
                        <td><%= equi.nroserie %></td>
                        <td><%= equi.tipo %></td>
                        <td><%= new Date(equi.fecha_mantenimiento).toLocaleDateString("es-AR", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }) %></td>
                        <td><%= equi.consultorio_idconsultorio %></td>                                        
                    </tr>                    
                <% }); %>
            <% }
            else{ %>
                <p>No hay datos para mostrar </p>
            <% } %>

            
        </tbody>
        </table>

    </div>

    <%- include('footer') %>

</body>
</html>