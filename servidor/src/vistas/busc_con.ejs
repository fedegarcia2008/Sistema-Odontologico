<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Buscar Convenio - Secure Dental</title>
</head>

<body>
 <%- include('header') %>


    <h1>BUSCAR CONVENIO</h1>

        <main class="formulario">

    <form onsubmit="busc_id(event)" method="GET">
        <div class="campo">
            <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave" maxlength="2">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
        
</form>

         <form onsubmit="busc_nom(event)" method="GET">
        <div class="campo">
            <label>Nombre:</label>
            <input type="text" id="nombre" name="nombre">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>


</form>
    </main>

<% if (cargado) { %>
        <% if (busc_registros.length > 0) { %>
      
                <p>Clave:  <%= busc_registros[0].idconvenio %></p>
                <p>Nombre:  <%= busc_registros[0].nombre %></p>
                <p>Rebaja:  <%= busc_registros[0].rebaja %></p>
      
            <% } else { %>

                    <p> No hay datos para mostrar</p>

            <% } %>
 <% } %>

<% if (cargado) { %>
<div class="tabla-contenedor">
    <table class="tabla-datos">
        <thead>
            <tr>
                <th>id</th>
                <th>nombre</th>
                <th>rebaja</th>
            </tr>
        </thead>
        <tbody>
            <% if (busc_registros.length > 0) {
                busc_registros.forEach(cons => { %>
                    <tr>
                        <td><%= con.idconvenio %></td>
                        <td><%= con.nombre %></td>
                        <td><%= con.rebaja %></td>
                    </tr>
                <% });
            } else { %>
                <tr>
                    <td colspan="6" class="sin-datos">No hay datos para mostrar</td>
                </tr>
            <% } %>
                      <% } %>
        </tbody>
    </table>
</div>

<%- include('footer') %>

<script src="/js/val_buscon.js"></script>
</body>
</html>