<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Buscar Cuenta Corriente - Secure Dental</title>
</head>

<body>
 <%- include('header') %>


    <h1>BUSCAR CUENTA CORRIENTE</h1>

        <main class="formulario">

    <form onsubmit="busc_form(event)" method="GET">
        <div class="campo">
            <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave"  >
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
</form>

<form onsubmit="busc_idhis(event)" method="GET">
        <div class="campo">
            <label>Id de la cuenta corriente:</label>
            <input type="text" id="clavehis" name="clavehis">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
</form>

<script>
    let form_eliminar = document.getElementById('form_eliminar');

    form_eliminar.addEventListener('submit', function(event) {
        event.preventDefault();

        let idhtml = '<%= baja_registros[0].ci_afiliado %>';

        if (confirm('¿Estás seguro de que querés eliminar este afiliado?')) {
            window.location.href = `/afiliado/eliminar/${encodeURIComponent(idhtml)}`;
        }
    });
    
</script>


    </main>

<% if (cargadoid) { %>
        <% if (busc_registros.length > 0) { %>
      
                <p>Id Afiliado:  <%= busc_registros[0].afiliado_ci_afiliado %></p>
                <p>Saldo:  <%= busc_registros[0].saldo%></p>
                <p>ID Tratamiento Realizado:  <%= busc_registros[0].tratamiento_realizado_idtratamiento_realizado %></p>
      
            <% } else { %>

                    <p> No hay datos para mostrar</p>

            <% } %>
 <% } %>

<%- include('footer') %>

<script src="/js/val_buscta.js"></script>

</body>
</html>