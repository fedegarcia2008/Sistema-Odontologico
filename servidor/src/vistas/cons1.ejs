<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css"> <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Consulta 1 - Secure Dental</title>
</head>

<body>
 <%- include('header') %>


    <h1>BUSCAR historia clínica del paciente</h1>

        <main class="formulario">

    <form onsubmit="busc_id(event)" method="GET">
        <div class="campo">
            <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave" >
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR POR CI">
        </div>
</form>

</main>
<script>
            function busc_id(event) {
        event.preventDefault();
        let idejs = document.getElementById('clave').value;
        window.location.href = `/consulta/historiaclinica/${idejs}`;
        document.getElementById('clave').value = "";        
    }
</script>

    <!-- <form onsubmit="busc_nom(event)" method="GET">
        <div class="campo">
            <label>Apellido y Nombre:</label>
            <input type="text" id="nombre" name="nombre">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR POR NOMBRE">
        </div>
</form> -->

<% if (cargado) { %>
<div class="tabla-contenedor">
    <table class="tabla-datos">
        <thead>
            <tr>
                <th>C.I.</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>ID Turno</th><!-- se puede sacar -->
                <th>Fecha del Turno</th>
                <th>Horario del turno</th>
                <th>nombre odo</th>
                <th>apellido odo</th>
                <th>nombre del trat</th>
                <th>fecha de inicio</th>
                <th>estado del tratamiento</th>
            </tr>
        </thead>
        <tbody>
            <% if (busc_registros.length > 0) {
                busc_registros.forEach(afi => { %>
                    <tr>
                        <td><%= afi.ci_afiliado %></td>
                        <td><%= afi.nombre %></td>
                        <td><%= afi.apellido %></td>
                        <td><%= afi.tel_cel ? afi.tel_cel : "Sin teléfono" %></td>
                        <td><%= afi.tel_fijo ? afi.tel_fijo : "Sin teléfono" %></td>
                        <td><%= afi.tipo_plan %></td>
                    </tr>
                <% });
            } else { %>
                <tr>
                    <td colspan="6" class="sin-datos">No hay datos para mostrar</td>
                </tr>
            <% } %>
                      <% } %>
        </tbody>
    </table>
</div>




<%- include('footer') %>





</body>
</html>