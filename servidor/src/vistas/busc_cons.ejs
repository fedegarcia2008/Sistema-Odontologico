<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Buscar Consultorio - Secure Dental</title>
</head>

<body>
 <%- include('header') %>


    <h1>BUSCAR CONSULTORIO</h1>

        <main class="formulario">

    <form onsubmit="busc_form(event)" method="GET">
        <div class="campo">
            <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave"  maxlength="3">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
        
        <form onsubmit="busc_num(event)" method="GET">
        <div class="campo">
            <label>Numero de Consultorio:</label>
            <input type="text" id="cons" name="cons"  maxlength="3">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>

</form>

</main>

<% if (federico) { %>
        <% if (busc_registros.length > 0) { %>
      
                <p>Clave:  <%= busc_registros[0].idconsultorio %></p>
                <p>Número:  <%= busc_registros[0].numero %></p>
                <p>Nro. local:  <%= busc_registros[0].local_idlocal %></p>
      
            <% } else { %>

                    <p> No hay datos para mostrar</p>

            <% } %>
 <% } %>

<%- include('footer') %>

<script src="/js/val_buscons.js"></script>
</body>
</html>