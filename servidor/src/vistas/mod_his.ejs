<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/estilos.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Modificar Historia Clinica - Secure Dental</title>
</head>

<body>
   <%- include('header') %>


   <h1>MODIFICAR HISTORIA CLINICA</h1>

        <main class="formulario">

    <form onsubmit="busc_form(event)" method="GET">
        <div class="campo">
            <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>

</form>

    </main>




<% if (cargado) { %>
<% if (busc_registros.length > 0) { %>

<form onsubmit="mod_form(event)" method="POST">

<div class="campo">

            <label>Identificador Único</label>
            <input type="text" name="clave" readonly
                            value="<%= busc_registros[0].idtratamiento_realizado %>">
        </div>

<div class="campo">
            <label>Fecha de inicio </label>
            <input type="date" name="fecha" 
                            value="<%= busc_registros[0].fecha_inicio %>">
        </div>

                <div class="campo">
            <label>Tratamiento finalizado </label>
            <select name="idTrat" id="idTrat" value= <%= busc_registros[0].tratamiento_realizado %>">
                <option value= 1>Finalizado</option>
                <option value= 0>En curso</option>
            </select>
        </div>
        <div class="campo">
            <label>Id servicio </label>
            <input type="text" name="idSer" readonly
                            value="<%= busc_registros[0].tratamiento_idtratamiento %>">
        </div>

        <div class="campo">
            <label>Id afiliado </label>
            <input type="text" name="idAfi" readonly
                            value="<%= busc_registros[0].afiliado_ci_afiliado %>">
        </div>

        <div class="campo">
            <label>Id odontologo</label>
            <input type="text" name="idOdo" readonly
                            value="<%= busc_registros[0].odontologo_idodontologo %>">
        </div>

        <div class="campo">
            <label>Id turno</label>
            <input type="text" name="idTur" readonly
                            value="<%= busc_registros[0].consulta_idconsulta %>"> 
        </div><!--maxlenght? pq es AI-->
        
        <div class="boton">
            <input type="submit" value="GUARDAR CAMBIOS">
        </div>
    </form>

<% } else { %>

    <p>No hay datos para mostrar.</p>

<% } %>
 <% } %>



        <script>
        function busc_form(event) {
        event.preventDefault();
        let idejs = document.getElementById('clave').value;
        window.location.href = `/historiaclinica/modificarid/${idejs}`;
        document.getElementById('clave').value = "";   
        }

    function mod_form(event) {
        event.preventDefault();

        let formulario = event.target;
        let idejs = formulario.querySelector('[name="clave"]').value;

        formulario.action = `/historiaclinica/modificar/${idejs}`;
        formulario.submit();
    }
        </script>





 <%- include('sweet_modificar') %>


            <%- include('footer') %>
 
</body>
</html>