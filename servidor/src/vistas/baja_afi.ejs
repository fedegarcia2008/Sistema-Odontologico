<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Baja Afiliado - Secure Dental</title>
</head>

<body>
 <%- include('header') %>

    <h1>BAJA AFILIADO</h1>
<main>

    <form onsubmit="baja_form(event)" method="GET">
        <div class="campo">
            <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave"  >
        </div>
        
        <input type="submit" class="confirmar" value="Confirmar">
</form>

<script>
    function baja_form(event) {
        event.preventDefault();
        let idhtml = document.getElementById('clave').value;
        window.location.href = `/afiliado/bajaxid/${idhtml}`;
        document.getElementById('clave').value = "";        
    }
</script>
    </main>

    
<% if (federico) { %>
        <% if (baja_registros.length > 0) { %>
      
                <p>Clave:  <%= baja_registros[0].ci_afiliado %></p>
                <p>Nombre:  <%= baja_registros[0].nombre %></p>
                <p>Apellido:  <%= baja_registros[0].apellido %></p>
                <p>Celular:  <%= baja_registros[0].tel_cel %></p>
                <p>Teléfono fijo:  <%= baja_registros[0].tel_fijo %></p>
                <p>Plan: <%= baja_registros[0].tipo_plan %></p>
      
<form id="form_eliminar">
    <button type="submit" class="confirmar">
        ELIMINAR
    </button>
</form>

            <% } else { %>

                    <p> No hay datos para mostrar</p>

            <% } %>



 <% } %>

 <script>
    let form_eliminar = document.getElementById('form_eliminar');

    form_eliminar.addEventListener('submit', function(event) {
        event.preventDefault();

        let idhtml = '<%= baja_registros[0].ci_afiliado %>';

        if (confirm('¿Estás seguro de que querés eliminar este afiliado?')) {
            window.location.href = `/afiliado/eliminar/${encodeURIComponent(idhtml)}`;
        }
    });
</script>
<%- include('footer') %>

</body>
</html>