<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/estilos.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Modificar Odontólogo - Secure Dental</title>
</head>

<body>
   <%- include('header') %>


   <h1>MODIFICAR ODONTóloGO</h1>

        <main class="formulario">

    <form onsubmit="busc_form(event)" method="GET">
        <div class="campo">
            <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>

</form>

    </main>




<% if (cargado) { %>
<% if (busc_registros.length > 0) { %>

<form onsubmit="mod_form(event)" method="POST">

<div class="campo">
            <label>Clave de identificación</label>
            <input type="text" name="clave" readonly
                            value="<%= busc_registros[0].idodontologo %>">
        </div>

        <div class="campo">
            <label>Nombre</label>
            <input type="text" name="nombre"
                            value="<%= busc_registros[0].nombre %>">
        </div>

        <div class="campo">
            <label>Apellido</label>
            <input type="text" name="apellido" 
                            value="<%= busc_registros[0].apellido %>">
        </div>

<div class="campo">
    <label>Tipo de Especialidad</label>

    <input type="text" name="especialidad" autocomplete="off" >

    <div id="listaEspecialidades" class="lista-especialidades"></div>
</div>

<div class="campo">
            <label>ID de consultorio</label>
            <input type="text" name="idCons" readonly
                            value="<%= busc_registros[0].consultorio_idconsultorio %>">
        </div>
         
        <div class="boton">

        <div class="boton">
            <input type="submit" value="GUARDAR CAMBIOS">
        </div>

    </form>

<% } else { %>

    <p>No hay datos para mostrar.</p>

<% } %>
 <% } %>



        <script>
        function busc_form(event) {
        event.preventDefault();
        let idejs = document.getElementById('clave').value;
        window.location.href = `/odontologo/modificarid/${idejs}`;
        document.getElementById('clave').value = "";   
        }

    function mod_form(event) {
        event.preventDefault();

        let formulario = event.target;
        let idejs = formulario.querySelector('[name="clave"]').value;

        formulario.action = `/odontologo/modificar/${idejs}`;
        formulario.submit();
    }
        </script>





 <%- include('sweet_modificar') %>


            <%- include('footer') %>
 
</body>
</html>