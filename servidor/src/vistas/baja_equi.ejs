<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Baja Equipamiento - Secure Dental</title>
</head>

<body>
 <%- include('header') %>

    <h1>BAJA EQUIPAMIENTO</h1>
 <main class="formulario">

    <form onsubmit="busc_id(event)" method="GET">
        <div class="campo">
            <label>Nro de serie:</label>
            <input type="text" id="clave" name="clave" maxlength="10">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>

</form>


    <form onsubmit="busc_tipo(event)" method="GET">
        <div class="campo">
            <label>Tipo de Equipamiento:</label>
            <input type="text" id="tipo" name="tipo">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>

</form>
</main>


<% if (cargado) { %>
<% if (baja_registros.length > 0 &&  baja_registros.length == 1) { %>

<form onsubmit="baja_id(event)" onsubmit="baja_tipo(event)"  method="POST">

<div class="campo">
            <label>Nro. de serie </label>
            <input type="text" name="clave" readonly
                            value="<%= baja_registros[0].nroserie %>">
        </div>

        <div class="campo">
            <label>Tipo </label>
            <input type="text" name="tipo" 
                            value="<%= baja_registros[0].tipo %>">
        </div>
        
        <div class="campo">
            <label>Fecha mantenimiento</label>
            <input type="date" name="fecha" 
                            value="<%= baja_registros[0].fecha_mantenimiento %>">
        </div>

        <div class="campo">
            <label>ID consultorio</label>
            <input type="text" name="idCons" readonly
                            value="<%= baja_registros[0].consultorio_idconsultorio %>">
        </div>

        <div class="boton">
            <input type="submit" value="GUARDAR CAMBIOS">
        </div>

    </form>

<% } else if (baja_registros.length >= 2) { %>

        
<div class="tabla-contenedor">
    <table class="tabla-datos">
        <thead>
            <tr>
            <th >Id</th>
            <th >Tipo</th>
            <th >Fecha</th>
            <th >id Consultorio</th>
            </tr>
        </thead>
        <tbody>
                <% baja_registros.forEach(equi => { %>
                    <tr>
                        <td><%= equi.nroserie %></td>
                        <td><%= equi.tipo %></td>
                        <td><%= new Date(equi.fecha_mantenimiento).toLocaleDateString("es-AR", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "UTC" }) %></td>
                        <td><%= equi.consultorio_idconsultorio %></td>                                        
                    </tr>                    
                <% }); %>
                 <p>Mas de una coincidencia al buscar. Modifique por ID</p>
                </tbody>
            </table>
        </div>

    <% } else if (baja_registros.length == 0) { %>

        <div class="formulario vacio">
            <i class="fa-solid fa-user-slash"></i>
            <p>No hay datos para mostrar.</p>
        </div>

<% } %>
 <% } %>



        <script>
        function busc_id(event) {
        event.preventDefault();
        let idejs = document.getElementById('clave').value;
        window.location.href = `/equipamiento/bajaid/${idejs}`;
        document.getElementById('clave').value = "";   
        }

    function baja_id(event) {
        event.preventDefault();

        let formulario = event.target; // guarda en la variable formulario lo que esta dentro de <form>
        let idejs = formulario.querySelector('[name="clave"]').value;

        formulario.action = `/equipamiento/baja/${idejs}`;
        formulario.submit();
    }

     function busc_tipo(event) {
        event.preventDefault();
        let idejs = document.getElementById('tipo').value;
        window.location.href = `/equipamiento/bajatipo/${idejs}`;
        document.getElementById('tipo').value = "";   
        }

    function baja_tipo(event) {
        event.preventDefault();

        let formulario = event.target; // guarda en la variable formulario lo que esta dentro de <form>
        let idejs = formulario.querySelector('[name="tipo"]').value;

        formulario.action = `/equipamiento/baja/${idejs}`;
        formulario.submit();
    }
        </script>

            <%- include('footer') %>
 
</body>
</html>