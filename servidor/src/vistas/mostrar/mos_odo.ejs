<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Mostrar Odontologos - Secure Dental</title>
</head>

<body>

    <%- include('header') %>

        <div>
        <h1>mostrar datos de todos los Odontologos</h1>
    </div>
    
<div class="tabla-contenedor">
    <table class="tabla-datos">
        <thead>
            <tr>
            <th >Id </th>
            <th >Nombre</th>
            <th >Apellido</th>
            <th >Especialidad</th>
            <th >Id Consultorio</th>
            
            </tr>
        </thead>
        <tbody>

            <% if (registros.length > 0) {
                registros.forEach(odo => { %>
                    <tr>
                        <td><%= odo.idodontologo %></td>
                        <td><%= odo.nombre %></td>
                        <td><%= odo.apellido %></td>  
                        <td><%= odo.especialidad %></td>  
                        <td><%= odo.consultorio_idconsultorio %></td> 
                    </tr>   
                <% }); %>
            <% }
            else{ %>
                <p>No hay datos para mostrar </p>
            <% } %>

            
        </tbody>
        </table>

    </div>

    <%- include('footer') %>

</body>
</html>