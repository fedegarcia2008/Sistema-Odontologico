<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/estilos.css">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="stylesheet" href="/css/mostrar.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Modificar Afiliado - Secure Dental</title>
</head>

<body>
   <%- include('header') %>


   <h1>MODIFICAR AFILIADO</h1>

        <main class="formulario">

    <form onsubmit="busc_id(event)" method="GET">
        <div class="campo">
            <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave" maxlength="10">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
</form>

<form onsubmit="busc_nom(event)" method="GET">
        <div class="campo">
            <label>Apellido y Nombre:</label>
            <input type="text" id="nombre" name="nombre" >
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
    </form>
</main>
    
<% if (cargado) { %>
<% if (busc_registros.length > 0 &&  busc_registros.length == 1) { %>
<main class="formulario">
<form class="formulario resultado" onsubmit="mod_id(event)" onsubmit="mod_nom(event)"  method="POST">

          <div class="campo">
            <label>Clave de Identificacion:</label>
        <input type="name" id="clave" name="clave" readonly value="<%= busc_registros[0].ci_afiliado %>">
</div>

    <div class="fila">
        <div class="campo">
            <label>Nombre:</label>
            <input type="text" name="nombre"
                   value="<%= busc_registros[0].nombre %>" required>
            </div>
        </div>


        <div class="fila">
        <div class="campo">

            <label>Apellido:</label>
            <input type="text" name="apellido"
                   value="<%= busc_registros[0].apellido %>" required>
        </div>

        <div class="fila">
        <div class="campo">
            <label>Celular:</label>
            <input type="text" name="telCelular"
                   value="<%= busc_registros[0].tel_cel %>">
        </div>
    </div>

        <div class="campo">
            <label>Teléfono fijo:</label>
            <input type="text" name="telFijo"
                   value="<%= busc_registros[0].tel_fijo %>">
        </div>

        <div class="fila">
        <div class="campo">
            <label>Tipo de plan</label>
            <input type="text" name="tipo" required value="<%= busc_registros[0].tipo_plan %>" >

        </div>
</div>

        <div class="boton">
            <input type="submit" value="GUARDAR CAMBIOS">
        </div>
    </form>

<% } else if (busc_registros.length >= 2) { %>

        <div class="tabla-contenedor">
            <table class="tabla-datos">
                <thead>
                    <tr>
                        <th>C.I.</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Teléfono Celular</th>
                        <th>Teléfono Fijo</th>
                        <th>Tipo de Plan</th>
                    </tr>
                </thead>

                <tbody>
                    <% busc_registros.forEach(afi => { %>
                        <tr>
                            <td><%= afi.ci_afiliado %></td>
                            <td><%= afi.nombre %></td>
                            <td><%= afi.apellido %></td>
                            <td><%= afi.tel_cel ? afi.tel_cel : "Sin teléfono" %></td>
                            <td><%= afi.tel_fijo ? afi.tel_fijo : "Sin teléfono" %></td>
                            <td><%= afi.tipo_plan %></td>
                        </tr>

                        
                    <% }); %>
                    <p>Mas de una coincidencia al buscar. Modifique por ID</p>
                </tbody>
            </table>
        </div>

    <% } else if (busc_registros.length == 0) { %>

        <div class="formulario vacio">
            <i class="fa-solid fa-user-slash"></i>
            <p>No hay datos para mostrar.</p>
        </div>

    <% } %>
<% } %>
</main>

        <script>
        function busc_id(event) {
        event.preventDefault();
        let idejs = document.getElementById('clave').value;
        window.location.href = `/afiliado/modificarid/${idejs}`;
        document.getElementById('clave').value = "";   
        }

    function mod_id(event) {
        event.preventDefault();

        let formulario = event.target;  // guarda en la variable formulario lo que esta dentro de <form>
        let idejs = formulario.querySelector('[name="clave"]').value;

        formulario.action = `/afiliado/modificar/${idejs}`;  // ruta
        formulario.submit();  // envio de datos
    }

    function busc_nom(event) {
        event.preventDefault();
        let idejs = document.getElementById('nombre').value;
        window.location.href = `/afiliado/modificarnombre/${idejs}`;
        document.getElementById('nombre').value = "";   
        }

    function mod_nom(event) {
        event.preventDefault();

        let formulario = event.target;  // guarda en la variable formulario lo que esta dentro de <form>
        let idejs = formulario.querySelector('[name="nombre"]').value;

        formulario.action = `/afiliado/modificar/${idejs}`;  // ruta
        formulario.submit();  // envio de datos
    }

        </script>
<!-- se borro sweet alert -->
            <%- include('footer') %>
 
</body>
</html>