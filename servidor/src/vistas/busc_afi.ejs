<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Buscar Afiliado - Secure Dental</title>
</head>

<body>
    <%- include('header') %>

    <h1>BUSCAR AFILIADO</h1>

    <main class="formulario">

        <form onsubmit="busc_id(event)" method="GET">
            <div class="campo">
                <label>Clave de identificación:</label>
                <input type="text" id="clave" name="clave" minlength="10" maxlength="10">
            </div>

            <div class="boton">
                <input type="submit" value="BUSCAR POR CI">
            </div>
        </form>

        <form onsubmit="busc_nom(event)" method="GET">
            <div class="campo">
                <label>Apellido y Nombre:</label>
                <input type="text" id="nombre" name="nombre" maxlength="50">
            </div>

            <div class="boton">
                <input type="submit" value="BUSCAR POR NOMBRE">
            </div>
        </form>

        <% if (federico) { %>
            <div class="resultados">
                <% if (busc_registros.length > 0) { %>
                    <% busc_registros.forEach(afi => { %>
                        <div class="ficha">
                            <p><strong>Clave:</strong> <%= afi.ci_afiliado %></p>
                            <p><strong>Nombre:</strong> <%= afi.nombre %></p>
                            <p><strong>Apellido:</strong> <%= afi.apellido %></p>
                            <p><strong>Celular:</strong> <%= afi.tel_cel ? afi.tel_cel : "Sin teléfono" %></p>
                            <p><strong>Teléfono fijo:</strong> <%= afi.tel_fijo ? afi.tel_fijo : "Sin teléfono" %></p>
                            <p><strong>Plan:</strong> <%= afi.tipo_plan %></p>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p class="sin-resultados">No hay datos para mostrar</p>
                <% } %>
            </div>
        <% } %>

    </main>

    <%- include('footer') %>

    <script src="/js/val_buscafi.js"></script>
</body>
</html>