<% if (cargado) { %>
        <% if (busc_registros.length > 0) { %>
      
                <p>Clave:  <%= busc_registros[0].ci_afiliado %></p>
                <p>Nombre:  <%= busc_registros[0].nombre %></p>
                <p>Apellido:  <%= busc_registros[0].apellido %></p>
                <p>Celular:  <%= busc_registros[0].tel_cel %></p>
                <p>Teléfono fijo:  <%= busc_registros[0].tel_fijo %></p>
                <p>Plan: <%= busc_registros[0].tipo_plan %></p>
      
            <% } else { %>

                    <p> No hay datos para mostrar</p>

            <% } %>
 <% } %>

<% if (cargado) { %>
<div class="tabla-contenedor">
    <table class="tabla-datos">
        <thead>
            <tr>
                <th>C.I.</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Teléfono Celular</th>
                <th>Teléfono Fijo</th>
                <th>Tipo de Plan</th>
            </tr>
        </thead>
        <tbody>
            <% if (busc_registros.length > 0) {
                busc_registros.forEach(afi => { %>
                    <tr>
                        <td><%= afi.ci_afiliado %></td>
                        <td><%= afi.nombre %></td>
                        <td><%= afi.apellido %></td>
                        <td><%= afi.tel_cel ? afi.tel_cel : "Sin teléfono" %></td>
                        <td><%= afi.tel_fijo ? afi.tel_fijo : "Sin teléfono" %></td>
                        <td><%= afi.tipo_plan %></td>
                    </tr>
                <% });
            } else { %>
                <tr>
                    <td colspan="6" class="sin-datos">No hay datos para mostrar</td>
                </tr>
            <% } %>
                      <% } %>
        </tbody>
    </table>
</div>




<%- include('footer') %>
<%- include('sweet_buscar') %>

<script src="/js/val_buscafi.js"></script>

</body>
