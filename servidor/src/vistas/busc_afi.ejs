<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Buscar Afiliado - Secure Dental</title>
</head>

<body>
 <%- include('header') %>


    <h1>BUSCAR AFILIADO</h1>

        <main class="formulario">

    <form onsubmit="busc_form(event)" method="GET">
        <div class="campo">
            <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave" minlength="10" maxlength="10">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>
        

</form>

    </main>

<% if (federico) { %>
    <section class="resultados">
        <% if (busc_registros.length > 0) { %>
            <% const afiliado = busc_registros[0]; %>

            <div class="ficha">
                <p class="clave">
                    Clave: <span><%= afiliado.ci_afiliado %></span>
                </p>

                <h2><%= afiliado.nombre %> <%= afiliado.apellido %></h2>

                <p>Plan: <strong><%= afiliado.tipo_plan %></strong></p>
                <p>Celular: <strong><%= afiliado.tel_cel %></strong></p>
                <p>Teléfono fijo: <strong><%= afiliado.tel_fijo %></strong></p>
            </div>

        <% } else { %>
            <p class="sin-resultados">No se encontró ningún afiliado con esa clave</p>
        <% } %>
    </section>
<% } %>

<%- include('footer') %>

<script src="/js/val_buscafi.js"></script>

</body>
</html>