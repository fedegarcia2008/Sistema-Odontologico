<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/menu.css">
    <link rel="icon" href="/img/favicon.webp">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <title>Baja Historia clinica - Secure Dental</title>
</head>

<body>
 <%- include('header') %>

    <h1>BAJA HISTORIA CLINICA</h1>
 <main class="formulario">

    <form onsubmit="busc_id(event)" method="GET">
        <div class="campo">
            <label>Clave de identificación:</label>
            <input type="text" id="clave" name="clave" maxlength="10">
        </div>
        
       <div class="boton">
        <input type="submit" value="BUSCAR">
        </div>

</form>

    
<% if (cargado) { %>
<% if (baja_registros.length > 0) { %>

<form class="formulario resultado" onsubmit="baja_form(event)" method="POST">

          <div class="campo">
            <label>Clave de Identificacion:</label>
        <input type="name" id="clave" name="clave" readonly value="<%= baja_registros[0].idtratamiento_realizado %>">
</div>

    <div class="fila">
        <div class="campo">
            <label>Fecha Inicio:</label>
            <input type="text" name="fecha_inicio"
                   readonly value="<%= new Date(baja_registros[0].fecha_inicio).toLocaleDateString("es-AR", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "UTC" })  %>" >
            </div>
        </div>


        <div class="fila">
        <div class="campo">
            <label>Tratamiento finalizado </label>
            <select name="idTrat" 
                            value="<%= baja_registros[0].tratamiento_finalizado %>">
                <option value="">Seleccione una opción</option>
                <option value= 1>Finalizado</option>
                <option value= 0>En curso</option>
            </select>
        </div>
        </div>

        

        <div class="fila">
        <div class="campo">
            <label>Id Tratamiento:</label>
            <input type="text" name=" tratamiento_idtratamiento"
                   readonly value="<%= baja_registros[0]. tratamiento_idtratamiento %>">
        </div>
    </div>

        <div class="campo">
            <label>Ci afiliado:</label>
            <input type="text" name="telFijo"
                   readonly value="<%= baja_registros[0].afiliado_ci_afiliado %>">
        </div>

        <div class="fila">
        <div class="campo">
            <label>Id odontologo</label>
            <input type="text" name="odontologo_idodontologo" readonly value="<%= baja_registros[0].odontologo_idodontologo %>" >

        </div>
        
        <div class="fila">
        <div class="campo">
            <label>Id consulta</label>
            <input type="text" name="consulta_idconsulta" readonly value="<%= baja_registros[0].consulta_idconsulta %>" >

        </div>
</div>


        <div class="boton">
            <input type="submit" value="ELIMINAR">
        </div>

    </form>

<% } else { %>
    <div class="formulario vacio">
    <i class="fa-solid fa-user-slash"></i>
    <p>No hay datos para mostrar.</p>
</div>
<% } %>
 <% } %>

</main>

        <script>
        function busc_id(event) {
        event.preventDefault();
        let idejs = document.getElementById('clave').value;
        window.location.href = `/historiaclinica/bajaid/${idejs}`;
        document.getElementById('clave').value = "";   
        }

    function baja_form(event) {
        event.preventDefault();

        let formulario = event.target; // guarda en la variable formulario lo que esta dentro de <form>
        let idejs = formulario.querySelector('[name="clave"]').value;

        formulario.action = `/historiaclinica/baja/${idejs}`;
        formulario.submit();
    }
        </script>

            <%- include('footer') %>
 
</body>
</html>